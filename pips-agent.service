[Unit]
Description=PIPS Autonomous VPS Agent & Mission Control Server
After=network.target

[Service]
Type=simple
User=afif-sofi
WorkingDirectory=/home/afif-sofi
ExecStart=/home/afif-sofi/.local/bin/pips-agent serve 20130
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
