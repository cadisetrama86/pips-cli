# ──────────────────────────────────────────────
# Agent ReAct Engine
# ──────────────────────────────────────────────
class PIPSAgent:
    def __init__(self, model_id: str = AGENT_MODEL, base_url: str = PIPS_BASE_URL, api_key: str = PIPS_API_KEY):
        self.model_id = model_id
        self.base_url = base_url
        self.api_key = api_key

        cwd = os.getcwd()
        os_platform = "Windows" if sys.platform == "win32" else ("macOS" if sys.platform == "darwin" else "Linux")
        username = os.environ.get("USERNAME") or os.environ.get("USER") or "user"

        self.system_prompt = (
            f"You are PIPS Agent, an autonomous AI system and coding engineer.\n"
            f"Active runtime environment:\n"
            f"- Working Directory (CWD): {cwd}\n"
            f"- Operating System: {os_platform} ({sys.platform})\n"
            f"- User: {username}\n\n"
            f"Guidelines:\n"
            f"1. When the user refers to 'path ini', 'folder ini', 'disini', or current working directory, they mean: {cwd}.\n"
            f"2. You have tools to execute shell commands, manage files, and inspect directory contents directly on this machine.\n"
            f"3. When asked to inspect, list files, trace, or check the current path, use your tools (like file_list or bash_run) immediately in {cwd}.\n"
            f"4. For shell commands, use syntax matching {os_platform} (e.g. dir/Get-ChildItem on Windows, ls on Linux/macOS).\n"
            f"5. Be proactive: run commands or read files to gather facts before answering.\n"
            f"6. Task Completion Priority: When asked to build a website, web page, or code project, ALWAYS create the primary HTML, CSS, and JS files FIRST using file_write before attempting optional asset downloads or secondary scripts. Never stop until the actual HTML and CSS files are completely written.\n"
            f"7. Use file_write to write files directly. Avoid writing multi-line inline scripts in bash_run if file_write can create the file directly.\n"
            f"8. When you finish building a web project, you can launch preview_server to let the user immediately preview it in their browser."
        )

    def dispatch_tool(self, name: str, args: dict) -> dict:
        """Route tool call to appropriate python function."""
        try:
            if name == "bash_run":
                return VPSTools.bash_run(args.get("command", ""), int(args.get("timeout", 45)))
            elif name == "vps_status":
                return VPSTools.vps_status()
            elif name == "docker_action":
                return VPSTools.docker_action(args.get("action", "ps"), args.get("container", ""))
            elif name == "file_read":
                return VPSTools.file_read(args.get("path", ""), int(args.get("start_line", 1)), int(args.get("max_lines", 200)))
            elif name == "file_write":
                return VPSTools.file_write(args.get("path", ""), args.get("content", ""), bool(args.get("overwrite", False)))
            elif name == "file_edit":
                return VPSTools.file_edit(args.get("path", ""), args.get("old_content", ""), args.get("new_content", ""))
            elif name == "file_list":
                return VPSTools.file_list(args.get("path", "."), int(args.get("max_depth", 2)))
            elif name == "preview_server":
                return VPSTools.preview_server(args.get("directory", "."), int(args.get("port", 3000)))
            else:
                return {"ok": False, "error": f"Unknown tool: {name}"}
        except Exception as e:
            return {"ok": False, "error": str(e)}

    def call_api(self, messages: list) -> dict:
        """Call 9Router / OpenAI chat completions API."""
        url = f"{self.base_url}/chat/completions"
        headers = {
            "Content-Type": "application/json",
            "Authorization": f"Bearer {self.api_key}",
            "User-Agent": "pips-agent/1.0",
        }
        payload = {
            "model": self.model_id,
            "messages": messages,
            "tools": TOOL_DEFINITIONS,
            "stream": False,
        }
        data = json.dumps(payload).encode("utf-8")
        req = urllib.request.Request(url, data=data, headers=headers, method="POST")

        with urllib.request.urlopen(req, timeout=240) as resp:
            body = resp.read().decode("utf-8")
            return json.loads(body)

    @staticmethod
    def load_session() -> list:
        session_file = os.path.expanduser("~/.pips/agent_session.json")
        try:
            if os.path.exists(session_file):
                with open(session_file, "r", encoding="utf-8") as f:
                    data = json.load(f)
                # Valid for 2 hours in the same working directory
                if time.time() - data.get("updated_at", 0) < 7200 and data.get("cwd") == os.getcwd():
                    return data.get("messages", [])
        except Exception:
            pass
        return []

    @staticmethod
    def save_session(messages: list):
        session_file = os.path.expanduser("~/.pips/agent_session.json")
        try:
            os.makedirs(os.path.dirname(session_file), exist_ok=True)
            compacted = []
            for m in messages:
                content = m.get("content", "")
                if m.get("role") == "tool" and len(content) > 1200:
                    m_copy = dict(m)
                    m_copy["content"] = content[:1200] + "... [truncated in session history]"
                    compacted.append(m_copy)
                else:
                    compacted.append(m)

            if len(compacted) > 25:
                compacted = [compacted[0]] + compacted[-24:]

            with open(session_file, "w", encoding="utf-8") as f:
                json.dump({
                    "cwd": os.getcwd(),
                    "updated_at": time.time(),
                    "messages": compacted
                }, f)
        except Exception:
            pass

    @staticmethod
    def clear_session():
        session_file = os.path.expanduser("~/.pips/agent_session.json")
        try:
            if os.path.exists(session_file):
                os.remove(session_file)
        except Exception:
            pass

    def run(self, user_prompt: str, history: list = None, event_callback=None, max_steps: int = 35) -> tuple[str, list]:
        """
        Run the ReAct autonomous loop.
        event_callback(event_type, data) allows streaming events to UI/CLI/SSE:
        event_type: 'thought' | 'tool_call' | 'tool_result' | 'final_answer' | 'error'
        """
        if history is None:
            saved = self.load_session()
            if saved:
                messages = saved
            else:
                messages = [{"role": "system", "content": self.system_prompt}]
        else:
            messages = list(history)

        messages.append({"role": "user", "content": user_prompt})

        step = 0
        final_answer = ""
        total_prompt_tokens = 0
        total_completion_tokens = 0

        while step < max_steps:
            step += 1
            if event_callback:
                event_callback("working", {"step": step})

            try:
                if HAS_RICH and console:
                    with console.status(
                        f"  [cyan]◓ Reviewing & Generating...[/cyan] [dim](Step {step}: AI is working, please wait)[/dim]",
                        spinner="dots"
                    ):
                        resp = self.call_api(messages)
                else:
                    print(f"  ◓ Reviewing & Generating... (Step {step}: AI is working, please wait)")
                    resp = self.call_api(messages)
            except Exception as e:
                err_msg = f"API Error: {e}"
                if event_callback:
                    event_callback("error", {"error": err_msg})
                return err_msg, messages

            usage = resp.get("usage", {})
            total_prompt_tokens += usage.get("prompt_tokens", 0)
            total_completion_tokens += usage.get("completion_tokens", 0)

            choices = resp.get("choices", [])
            if not choices:
                break

            choice = choices[0]
            msg = choice.get("message", {})
            reasoning = msg.get("reasoning_content", "")
            content = msg.get("content", "") or ""
            tool_calls = msg.get("tool_calls", [])

            # Broadcast reasoning if present
            if reasoning and event_callback:
                event_callback("thought", {"thought": reasoning})

            # If no tools called, we're done
            if not tool_calls:
                final_answer = content
                messages.append({"role": "assistant", "content": content})
                if event_callback:
                    event_callback("final_answer", {"content": content})
                break

            # Add assistant message with tool calls to history
            assistant_msg = {"role": "assistant", "content": content, "tool_calls": tool_calls}
            messages.append(assistant_msg)

            # Execute tool calls
            for tc in tool_calls:
                fn = tc.get("function", {})
                name = fn.get("name", "")
                call_id = tc.get("id", f"call_{step}")
                try:
                    args = json.loads(fn.get("arguments", "{}"))
                except json.JSONDecodeError:
                    args = {}

                if event_callback:
                    event_callback("tool_call", {"id": call_id, "name": name, "arguments": args})

                # Run tool on VPS
                result = self.dispatch_tool(name, args)

                if event_callback:
                    event_callback("tool_result", {"id": call_id, "name": name, "result": result})

                # Append tool result to messages (with token-saving compaction)
                res_str = json.dumps(result, ensure_ascii=False)
                if len(res_str) > 3000:
                    res_str = res_str[:1800] + "\n... [content truncated to save tokens] ...\n" + res_str[-800:]
                messages.append({
                    "role": "tool",
                    "tool_call_id": call_id,
                    "content": res_str
                })

        if not final_answer:
            final_answer = "⚠ Selesai hingga batas langkah eksekusi (35 steps). Semua file dan aset yang telah dibuat tersimpan aman. Ketik instruksi lanjutan untuk melanjutkan jika masih ada yang diperlukan."
            if event_callback:
                event_callback("final_answer", {"content": final_answer})

        self.save_session(messages)

        if total_completion_tokens > 0 and HAS_RICH and console:
            console.print(f"  [dim]⚡ Used ~{total_prompt_tokens + total_completion_tokens:,} tokens ({total_prompt_tokens:,} in, {total_completion_tokens:,} out) in {step} steps[/dim]\n")

        return final_answer, messages


