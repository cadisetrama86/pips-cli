# ──────────────────────────────────────────────
# Safety guardrails
# ──────────────────────────────────────────────
BLOCKED_COMMANDS = [
    "rm -rf /", "rm -rf /*", ":(){ :|:& };:", "mkfs", "dd if=/dev/zero of=/dev/",
    "dd if=/dev/random of=/dev/", "> /dev/sda", "> /dev/vda", "shutdown -h now",
    "init 0"
]

def is_command_safe(cmd: str) -> tuple[bool, str]:
    cmd_clean = cmd.strip().lower()
    for blocked in BLOCKED_COMMANDS:
        if blocked in cmd_clean:
            return False, f"Command contains forbidden pattern: '{blocked}'"
    return True, ""


# ──────────────────────────────────────────────
# VPS Tools Implementation
# ──────────────────────────────────────────────
class VPSTools:
    @staticmethod
    def bash_run(command: str, timeout: int = 45) -> dict:
        """Execute a bash command on the VPS."""
        safe, reason = is_command_safe(command)
        if not safe:
            return {"ok": False, "error": f"Security restriction: {reason}", "exit_code": -1}

        try:
            start_t = time.time()
            if sys.platform == "win32":
                shell_cmd = ["powershell", "-NoProfile", "-Command", command]
            else:
                shell_cmd = ["bash", "-c", command]

            proc = subprocess.run(
                shell_cmd,
                capture_output=True,
                text=True,
                timeout=timeout,
                cwd=os.getcwd()
            )
            duration = round(time.time() - start_t, 2)
            stdout = proc.stdout
            stderr = proc.stderr

            # Truncate if output is too massive
            max_chars = 6000
            if len(stdout) > max_chars:
                stdout = stdout[:max_chars] + f"\n... [truncated, {len(proc.stdout) - max_chars} characters omitted]"
            if len(stderr) > max_chars:
                stderr = stderr[:max_chars] + f"\n... [truncated stderr]"

            return {
                "ok": proc.returncode == 0,
                "exit_code": proc.returncode,
                "stdout": stdout,
                "stderr": stderr,
                "duration_seconds": duration
            }
        except subprocess.TimeoutExpired:
            return {"ok": False, "error": f"Command timed out after {timeout} seconds", "exit_code": 124}
        except Exception as e:
            return {"ok": False, "error": str(e), "exit_code": 1}

    @staticmethod
    def file_read(path: str, start_line: int = 1, max_lines: int = 250) -> dict:
        """Read lines from a file."""
        expanded = os.path.expanduser(path)
        if not os.path.exists(expanded):
            return {"ok": False, "error": f"File not found: {path}"}
        if os.path.isdir(expanded):
            return {"ok": False, "error": f"Path is a directory, not a file: {path}"}

        try:
            lines = []
            with open(expanded, "r", encoding="utf-8", errors="replace") as f:
                for idx, line in enumerate(f, start=1):
                    if idx >= start_line:
                        lines.append(f"{idx}: {line.rstrip('\\n')}")
                    if len(lines) >= max_lines:
                        lines.append(f"... [truncated at {max_lines} lines]")
                        break

            return {
                "ok": True,
                "path": path,
                "total_read": len(lines),
                "content": "\n".join(lines)
            }
        except Exception as e:
            return {"ok": False, "error": str(e)}

    @staticmethod
    def file_write(path: str, content: str, overwrite: bool = False) -> dict:
        """Write content to a file."""
        expanded = os.path.expanduser(path)
        if os.path.exists(expanded) and not overwrite:
            return {"ok": False, "error": f"File exists already. Set overwrite=true to overwrite."}

        try:
            os.makedirs(os.path.dirname(os.path.abspath(expanded)), exist_ok=True)
            with open(expanded, "w", encoding="utf-8") as f:
                f.write(content)
            return {"ok": True, "path": path, "bytes_written": len(content)}
        except Exception as e:
            return {"ok": False, "error": str(e)}

    @staticmethod
    def file_edit(path: str, old_content: str, new_content: str) -> dict:
        """Replace text in a file with unified diff preview."""
        expanded = os.path.expanduser(path)
        if not os.path.exists(expanded):
            return {"ok": False, "error": f"File not found: {path}"}

        try:
            with open(expanded, "r", encoding="utf-8") as f:
                data = f.read()

            if old_content not in data:
                return {"ok": False, "error": "Target content not found in file."}

            occurrences = data.count(old_content)
            if occurrences > 1:
                return {"ok": False, "error": f"Target content occurs {occurrences} times. Must be unique."}

            updated = data.replace(old_content, new_content, 1)
            with open(expanded, "w", encoding="utf-8") as f:
                f.write(updated)

            # Generate unified diff
            import difflib
            diff_lines = list(difflib.unified_diff(
                old_content.splitlines(keepends=True),
                new_content.splitlines(keepends=True),
                fromfile=f"a/{os.path.basename(path)}",
                tofile=f"b/{os.path.basename(path)}"
            ))
            diff_text = "".join(diff_lines)

            return {"ok": True, "path": path, "replaced": True, "diff": diff_text}
        except Exception as e:
            return {"ok": False, "error": str(e)}

    @staticmethod
    def preview_server(directory: str = ".", port: int = 3000) -> dict:
        """Launch background HTTP preview server for web projects."""
        import threading
        from http.server import HTTPServer, SimpleHTTPRequestHandler

        expanded = os.path.expanduser(directory)
        if not os.path.exists(expanded):
            return {"ok": False, "error": f"Directory not found: {directory}"}

        chosen_port = port
        for p in range(port, port + 20):
            with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
                if s.connect_ex(("127.0.0.1", p)) != 0:
                    chosen_port = p
                    break

        class CustomHandler(SimpleHTTPRequestHandler):
            def __init__(self, *args, **kwargs):
                super().__init__(*args, directory=os.path.abspath(expanded), **kwargs)
            def log_message(self, format, *args):
                pass

        try:
            httpd = HTTPServer(("0.0.0.0", chosen_port), CustomHandler)
            thread = threading.Thread(target=httpd.serve_forever, daemon=True)
            thread.start()
            url = f"http://localhost:{chosen_port}"
            return {
                "ok": True,
                "port": chosen_port,
                "url": url,
                "directory": os.path.abspath(expanded),
                "message": f"Preview live at {url}"
            }
        except Exception as e:
            return {"ok": False, "error": str(e)}

    @staticmethod
    def file_list(path: str = ".", max_depth: int = 2) -> dict:
        """List files and directories."""
        expanded = os.path.expanduser(path)
        if not os.path.exists(expanded):
            return {"ok": False, "error": f"Directory not found: {path}"}

        items = []
        try:
            expanded = os.path.abspath(expanded)
            base_depth = expanded.rstrip(os.path.sep).count(os.path.sep)
            for root, dirs, files in os.walk(expanded):
                current_depth = root.count(os.path.sep) - base_depth
                if current_depth >= max_depth:
                    dirs.clear()
                    continue

                rel_root = os.path.relpath(root, expanded)
                if rel_root == ".":
                    rel_root = ""

                for d in sorted(dirs):
                    if d.startswith(".") and d not in (".pips", ".9router"):
                        continue
                    items.append({"type": "dir", "path": os.path.join(rel_root, d)})

                for f in sorted(files):
                    if f.startswith(".") and not f.startswith(".env"):
                        continue
                    fp = os.path.join(root, f)
                    try:
                        sz = os.path.getsize(fp)
                    except OSError:
                        sz = 0
                    items.append({"type": "file", "path": os.path.join(rel_root, f), "size_bytes": sz})

                if len(items) >= 200:
                    items.append({"type": "info", "path": "... [truncated at 200 items]"})
                    break

            return {"ok": True, "base_path": path, "total": len(items), "items": items}
        except Exception as e:
            return {"ok": False, "error": str(e)}

    @staticmethod
    def vps_status() -> dict:
        """Get VPS system stats, resources, and Docker overview."""
        metrics = {
            "timestamp": datetime.now().isoformat(),
            "hostname": socket.gethostname(),
        }

        # psutil metrics
        if psutil:
            metrics["cpu_percent"] = psutil.cpu_percent(interval=0.2)
            vm = psutil.virtual_memory()
            metrics["ram"] = {
                "total_gb": round(vm.total / (1024**3), 2),
                "used_gb": round(vm.used / (1024**3), 2),
                "percent": vm.percent
            }
            disk = psutil.disk_usage("/")
            metrics["disk"] = {
                "total_gb": round(disk.total / (1024**3), 2),
                "used_gb": round(disk.used / (1024**3), 2),
                "percent": disk.percent
            }
            metrics["load_avg"] = [round(x, 2) for x in os.getloadavg()] if hasattr(os, "getloadavg") else [0.0, 0.0, 0.0]
        else:
            metrics["load_avg"] = [round(x, 2) for x in os.getloadavg()] if hasattr(os, "getloadavg") else [0.0, 0.0, 0.0]

        # Docker status
        try:
            proc = subprocess.run(
                ["docker", "ps", "--format", "{{.Names}}||{{.Status}}||{{.Ports}}"],
                capture_output=True, text=True, timeout=5
            )
            containers = []
            if proc.returncode == 0 and proc.stdout.strip():
                for line in proc.stdout.strip().splitlines():
                    parts = line.split("||")
                    if len(parts) >= 2:
                        containers.append({
                            "name": parts[0],
                            "status": parts[1],
                            "ports": parts[2] if len(parts) > 2 else ""
                        })
            metrics["docker_containers"] = containers
            metrics["docker_running_count"] = len(containers)
        except Exception as e:
            metrics["docker_error"] = str(e)

        return {"ok": True, "metrics": metrics}

    @staticmethod
    def docker_action(action: str, container: str = "") -> dict:
        """Perform action on Docker container (ps, logs, restart, stats)."""
        action = action.lower().strip()
        if action == "ps":
            return VPSTools.vps_status()

        if not container:
            return {"ok": False, "error": "container name is required for action: " + action}

        if action == "logs":
            cmd = f"docker logs --tail 60 {container}"
            return VPSTools.bash_run(cmd, timeout=10)
        elif action == "restart":
            cmd = f"docker restart {container}"
            return VPSTools.bash_run(cmd, timeout=30)
        elif action == "stats":
            cmd = f"docker stats --no-stream {container}"
            return VPSTools.bash_run(cmd, timeout=10)
        else:
            return {"ok": False, "error": f"Unsupported docker action: {action}"}


