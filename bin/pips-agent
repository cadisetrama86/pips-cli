let isBusy = false;

async function refreshStats() {
  try {
    const res = await fetch('/api/agent/status');
    const data = await res.json();
    if (data.ok && data.metrics) {
      const m = data.metrics;
      if (m.cpu_percent !== undefined) {
        document.getElementById('cpu-val').innerText = m.cpu_percent + '%';
        document.getElementById('cpu-bar').style.width = m.cpu_percent + '%';
      }
      if (m.ram) {
        document.getElementById('ram-val').innerText = m.ram.percent + '%';
        document.getElementById('ram-bar').style.width = m.ram.percent + '%';
      }
      if (m.disk) {
        document.getElementById('disk-val').innerText = m.disk.percent + '%';
        document.getElementById('disk-bar').style.width = m.disk.percent + '%';
        document.getElementById('disk-details').innerText = `${m.disk.used_gb}/${m.disk.total_gb} GB`;
      }
      if (m.docker_containers) {
        document.getElementById('docker-count').innerText = m.docker_containers.length;
        const listEl = document.getElementById('docker-list');
        listEl.innerHTML = '';
        m.docker_containers.forEach(c => {
          const div = document.createElement('div');
          div.className = 'docker-item';
          div.innerHTML = `<span class="docker-name">${c.name}</span><span class="docker-status">${c.status.split(' ')[0]}</span>`;
          listEl.appendChild(div);
        });
      }
    }
  } catch(e) {
    console.error('Stats error:', e);
  }
}

setInterval(refreshStats, 5000);
refreshStats();

document.getElementById('prompt-input').addEventListener('keydown', (e) => {
  if (e.key === 'Enter' && !e.shiftKey) {
    e.preventDefault();
    sendPrompt();
  }
});

async function sendPrompt() {
  if (isBusy) return;
  const inputEl = document.getElementById('prompt-input');
  const text = inputEl.value.trim();
  if (!text) return;

  inputEl.value = '';
  isBusy = true;
  document.getElementById('btn-send').disabled = true;

  const chatBox = document.getElementById('chat-box');

  // User msg
  const userRow = document.createElement('div');
  userRow.className = 'msg-row user';
  userRow.innerHTML = `<div class="msg-author">You</div><div class="msg-bubble">${escapeHtml(text)}</div>`;
  chatBox.appendChild(userRow);

  // Assistant msg placeholder
  const assistRow = document.createElement('div');
  assistRow.className = 'msg-row assistant';
  const bubble = document.createElement('div');
  bubble.className = 'msg-bubble';
  bubble.innerHTML = '<span style="color:var(--muted)">Thinking & orchestrating tools...</span>';
  assistRow.appendChild(document.createElement('div')).className = 'msg-author';
  assistRow.querySelector('.msg-author').innerText = 'PIPS Agent 🤖';
  assistRow.appendChild(bubble);
  chatBox.appendChild(assistRow);
  chatBox.scrollTop = chatBox.scrollHeight;

  try {
    const res = await fetch('/api/agent/chat', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ prompt: text })
    });

    const reader = res.body.getReader();
    const decoder = new TextDecoder();
    bubble.innerHTML = '';

    while (true) {
      const { done, value } = await reader.read();
      if (done) break;
      const chunk = decoder.decode(value);
      const lines = chunk.split('\\n');

      for (const line of lines) {
        if (line.startsWith('data: ')) {
          try {
            const ev = JSON.parse(line.substring(6));
            if (ev.type === 'tool_call') {
              const toolCard = document.createElement('div');
              toolCard.className = 'tool-box';
              toolCard.id = 'tc-' + ev.data.id;
              toolCard.innerHTML = `<div class="tool-header">⚙ Executing: ${ev.data.name}</div><div class="tool-body">${escapeHtml(JSON.stringify(ev.data.arguments, null, 2))}</div>`;
              bubble.appendChild(toolCard);
            } else if (ev.type === 'tool_result') {
              const toolCard = document.getElementById('tc-' + ev.data.id);
              if (toolCard) {
                const out = ev.data.result.stdout || JSON.stringify(ev.data.result, null, 2);
                toolCard.querySelector('.tool-body').innerText = out;
              }
            } else if (ev.type === 'final_answer') {
              const ansDiv = document.createElement('div');
              ansDiv.style.marginTop = '12px';
              ansDiv.innerText = ev.data.content;
              bubble.appendChild(ansDiv);
            }
          } catch(err) {}
        }
      }
      chatBox.scrollTop = chatBox.scrollHeight;
    }
  } catch(e) {
    bubble.innerHTML = `<span style="color:var(--red)">Connection Error: ${escapeHtml(e.message)}</span>`;
  } finally {
    isBusy = false;
    document.getElementById('btn-send').disabled = false;
    refreshStats();
  }
}

function escapeHtml(str) {
  return str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;");
}
</script>
