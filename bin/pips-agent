# ──────────────────────────────────────────────
# Agent HTTP Server & Handler
# ──────────────────────────────────────────────
class AgentServerHandler(SimpleHTTPRequestHandler):
    agent_instance = None

    def end_headers(self):
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Access-Control-Allow-Headers", "Content-Type, Authorization")
        self.send_header("Access-Control-Allow-Methods", "GET, POST, OPTIONS")
        super().end_headers()

    def do_OPTIONS(self):
        self.send_response(200)
        self.end_headers()

    def do_GET(self):
        parsed = urlparse(self.path)
        path = parsed.path

        if path in ("/", "/dashboard", "/agent"):
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.end_headers()
            self.wfile.write(DASHBOARD_HTML.encode("utf-8"))
            return

        elif path in ("/api/agent/status", "/health"):
            data = VPSTools.vps_status()
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.end_headers()
            self.wfile.write(json.dumps(data).encode("utf-8"))
            return

        elif path == "/api/agent/tools":
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.end_headers()
            self.wfile.write(json.dumps({"ok": True, "tools": TOOL_DEFINITIONS}).encode("utf-8"))
            return

        self.send_response(404)
        self.end_headers()
        self.wfile.write(b"Not Found")

    def do_POST(self):
        parsed = urlparse(self.path)
        path = parsed.path

        if path == "/api/agent/chat":
            content_len = int(self.headers.get("Content-Length", 0))
            post_body = self.rfile.read(content_len).decode("utf-8")
            try:
                body = json.loads(post_body)
            except json.JSONDecodeError:
                self.send_response(400)
                self.end_headers()
                self.wfile.write(b'{"error": "Invalid JSON"}')
                return

            prompt = body.get("prompt", "")
            if not prompt:
                self.send_response(400)
                self.end_headers()
                self.wfile.write(b'{"error": "prompt is required"}')
                return

            # SSE Response
            self.send_response(200)
            self.send_header("Content-Type", "text/event-stream")
            self.send_header("Cache-Control", "no-cache")
            self.send_header("Connection", "keep-alive")
            self.end_headers()

            def event_cb(ev_type, data):
                packet = f"data: {json.dumps({'type': ev_type, 'data': data}, ensure_ascii=False)}\\n\\n"
                try:
                    self.wfile.write(packet.encode("utf-8"))
                    self.wfile.flush()
                except Exception:
                    pass

            # Run agent loop
            self.agent_instance.run(prompt, event_callback=event_cb)
            return

        self.send_response(404)
        self.end_headers()


def start_server(port: int = AGENT_PORT):
    agent = PIPSAgent()
    AgentServerHandler.agent_instance = agent
    server = ThreadingHTTPServer(("0.0.0.0", port), AgentServerHandler)
    print(f"🚀 PIPS Agent Server running on http://0.0.0.0:{port}")
    print(f"📊 Dashboard available at: http://localhost:{port}/")
    print(f"⚡ Model: {agent.model_id} via {agent.base_url}")
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print("\nStopping PIPS Agent Server...")
        server.server_close()


# ──────────────────────────────────────────────
# Multiline & Shift+Enter Input Handler
# ──────────────────────────────────────────────
def is_modifier_held() -> bool:
    """Check if Shift, Alt, or Ctrl key was held down on Windows."""
    if sys.platform == "win32":
        try:
            import ctypes
            u32 = ctypes.windll.user32
            shift_pressed = (u32.GetAsyncKeyState(0x10) & 0x8000) != 0
            alt_pressed = (u32.GetAsyncKeyState(0x12) & 0x8000) != 0
            return shift_pressed or alt_pressed
        except Exception:
            return False
    return False


def has_buffered_input() -> bool:
    """Check if more pasted input is currently queued in stdin."""
    if sys.platform == "win32":
        try:
            import msvcrt
            return msvcrt.kbhit() != 0
        except Exception:
            return False
    else:
        try:
            import select
            r, _, _ = select.select([sys.stdin], [], [], 0.02)
            return bool(r)
        except Exception:
            return False


def has_unclosed_quotes(text: str) -> bool:
    """Check if text has unclosed triple quotes or markdown fence."""
    for q in ('"""', "'''", "```"):
        if text.count(q) % 2 != 0:
            return True
    return False


def read_user_input(prompt_sym: str) -> str:
    """Read user input with Shift+Enter, line continuation, and paste support."""
    lines = []
    continuation_prompt = "   ...   "

    while True:
        curr_prompt = prompt_sym if not lines else continuation_prompt
        try:
            line = input(curr_prompt)
        except EOFError:
            if lines:
                break
            raise

        shift_held = is_modifier_held()
        pasted_more = has_buffered_input()

        has_backslash = line.rstrip().endswith("\\")
        if has_backslash:
            line = line.rstrip()[:-1]

        lines.append(line)
        current_full = "\n".join(lines)

        should_continue = (
            shift_held or
            has_backslash or
            has_unclosed_quotes(current_full) or
            pasted_more
        )

        if not should_continue:
            break

    return "\n".join(lines)


# ──────────────────────────────────────────────
# Interactive CLI Mode
# ──────────────────────────────────────────────
def run_cli(prompt: str = None):
    agent = PIPSAgent()

    if HAS_RICH:
        console.print(Panel(
            Text.from_markup(
                f"[bold #ff3344]💀 PIPS Autonomous VPS Agent[/bold #ff3344] [dim #888888]• Crimson Protocol[/dim #888888]\n"
                f"[dim]Model :[/dim] [bold white]{agent.model_id}[/bold white]\n"
                f"[dim]Target:[/dim] [white]Local VPS ({socket.gethostname()})[/white]\n"
                f"[dim]Tools :[/dim] [dim #ff6b81]bash_run, vps_status, docker_action, file_ops, preview_server[/dim #ff6b81]"
            ),
            border_style="#cc0029",
            padding=(0, 2)
        ))
    else:
        print(f"=== 💀 PIPS Autonomous VPS Agent ({agent.model_id}) ===")

    def cli_event_cb(ev_type, data):
        if HAS_RICH:
            if ev_type == "thought":
                thought_text = data.get("thought", "").strip()
                first_line = thought_text.splitlines()[0] if thought_text else ""
                snippet = first_line[:120] + ("..." if len(first_line) > 120 else "")
                console.print(f"  [bold #ff4d4d]◓ Reviewing...[/bold #ff4d4d] [dim]{snippet}[/dim]")
            elif ev_type == "tool_call":
                name = data.get("name", "")
                args = data.get("arguments", {})
                if name == "file_list":
                    target = args.get("path", ".")
                    console.print(f"  [#ff4757]⌕ Searching...[/#ff4757] [white]{target}[/white]")
                elif name == "file_read":
                    target = args.get("path", "")
                    console.print(f"  [#ff6b81]📖 Reading...[/#ff6b81] [white]{target}[/white]")
                elif name in ("file_edit", "file_write"):
                    target = args.get("path", "")
                    content_len = len(args.get("content", ""))
                    size_hint = f" [dim]({content_len:,} chars)[/dim]" if content_len else ""
                    console.print(f"  [#ff9f43]✎ Editing...[/#ff9f43] [white]{target}[/white]{size_hint}")
                elif name == "preview_server":
                    target = args.get("directory", ".")
                    console.print(f"  [bold #ff3344]🌐 Preview Server...[/bold #ff3344] [white]{target}[/white]")
                else:
                    cmd_info = args.get("command") or args.get("action") or json.dumps(args)
                    console.print(f"  [bold #ff3344]⚙ Running tool...[/bold #ff3344] [bold #ffa502]{name}[/bold #ffa502] [dim]({cmd_info})[/dim]")
            elif ev_type == "tool_result":
                res = data.get("result", {})
                if res.get("ok"):
                    name = data.get("name", "")
                    if name == "file_list":
                        summary = f"[dim]found {res.get('total', len(res.get('items', [])))} items[/dim]"
                    elif name == "file_write":
                        summary = f"[dim]saved {res.get('bytes_written', 0):,} bytes[/dim]"
                    elif name == "file_read":
                        summary = f"[dim]read {res.get('total_read', 0)} lines[/dim]"
                    elif name == "file_edit":
                        summary = "[dim]updated content[/dim]"
                    elif name == "preview_server":
                        summary = f"[dim]preview live at[/dim] [bold cyan]{res.get('url')}[/bold cyan]"
                    elif name == "bash_run":
                        summary = f"[dim]exit {res.get('exit_code', 0)} in {res.get('duration_seconds', 0)}s[/dim]"
                    else:
                        out = res.get("stdout") or str(res)
                        summary = "[dim]" + out.strip().replace("\n", " ")[:100] + "[/dim]"
                    console.print(f"  [bold green]✓ Done[/bold green] {summary}")

                    if res.get("diff"):
                        console.print()
                        for dline in res.get("diff").splitlines()[:25]:
                            if dline.startswith("+") and not dline.startswith("+++"):
                                console.print(f"    [green]{dline}[/green]")
                            elif dline.startswith("-") and not dline.startswith("---"):
                                console.print(f"    [red]{dline}[/red]")
                            elif dline.startswith("@"):
                                console.print(f"    [cyan]{dline}[/cyan]")
                        console.print()
                else:
                    err = res.get("error", "action failed")
                    console.print(f"  [bold red]✗ Failed:[/bold red] [yellow]{err}[/yellow]")
            elif ev_type == "final_answer":
                console.print()
                console.print(Rule(style="#cc0029"))
                console.print()
                console.print(Markdown(data.get("content", "")))
                console.print()
        else:
            if ev_type == "thought":
                print("  ◓ Reviewing...")
            elif ev_type == "tool_call":
                name = data.get("name", "")
                args = data.get("arguments", {})
                if name == "file_list":
                    print(f"  ⌕ Searching... {args.get('path', '.')}")
                elif name == "file_read":
                    print(f"  📖 Reading... {args.get('path', '')}")
                elif name in ("file_edit", "file_write"):
                    print(f"  ✎ Editing... {args.get('path', '')}")
                else:
                    print(f"  ⚙ Running tool... {name}")
            elif ev_type == "tool_result":
                if data.get("result", {}).get("ok"):
                    print("  ✓ Done")
                else:
                    print(f"  ✗ Failed: {data.get('result', {}).get('error')}")
            elif ev_type == "final_answer":
                print(f"\n[Agent Answer]:\n{data.get('content')}\n")

    history = None
    if prompt:
        agent.run(prompt, history=history, event_callback=cli_event_cb)
        return

    while True:
        try:
            user_in = read_user_input("\n[🔥 pips-agent] ❯ ").strip()
        except (KeyboardInterrupt, EOFError):
            print("\nExiting agent.")
            break
        if not user_in:
            continue
        if user_in in ("/exit", "/quit", "exit", "quit"):
            break
        if user_in in ("/paste", "/multiline"):
            if HAS_RICH:
                console.print(Panel(
                    Text.from_markup(
                        "[bold #ff3344]📝 Multiline / Paste Mode[/bold #ff3344]\n"
                        "[dim #888888]Type or paste your prompt. Type [bold white]EOF[/bold white] or press [bold white]Enter[/bold white] on an empty line when done.[/dim #888888]"
                    ),
                    border_style="#cc0029",
                    padding=(0, 2)
                ))
            else:
                print("📝 Multiline / Paste Mode (type EOF or press Enter on empty line to finish):")
            p_lines = []
            while True:
                try:
                    sub = input("  ... ")
                except (EOFError, KeyboardInterrupt):
                    break
                if sub.strip() == "EOF" or (not sub and p_lines):
                    break
                p_lines.append(sub)
            user_in = "\n".join(p_lines).strip()
            if not user_in:
                continue

        _, history = agent.run(user_in, history=history, event_callback=cli_event_cb)


# ──────────────────────────────────────────────
# Main Entry Point
# ──────────────────────────────────────────────
if __name__ == "__main__":
    if len(sys.argv) > 1:
        arg = sys.argv[1].lower()
        if arg in ("serve", "--serve", "server", "-s"):
            port = int(sys.argv[2]) if len(sys.argv) > 2 else AGENT_PORT
            start_server(port)
            sys.exit(0)
        elif arg in ("--help", "-h"):
            print("Usage:")
            print("  pips-agent                    # Interactive CLI agent mode")
            print("  pips-agent 'task prompt'      # Run single agent task")
            print("  pips-agent serve [port]       # Start Agent Server & Web Dashboard")
            sys.exit(0)
        else:
            # Single prompt mode
            run_cli(" ".join(sys.argv[1:]))
            sys.exit(0)

    run_cli()
