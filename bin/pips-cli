    ))


# ──────────────────────────────────────────────
# Stream Chat Response (Urllib / SSE)
# ──────────────────────────────────────────────
def stream_chat(messages: list, model_id: str):
    """Stream response from 9Router, yields tokens safely."""
    url = f"{ROUTER_BASE_URL}/chat/completions"
    headers = {
        "Content-Type":  "application/json",
        "Authorization": f"Bearer {API_KEY}",
        "Accept":        "text/event-stream",
        "User-Agent":    "pips-cli/2.0",
    }
    payload = json.dumps({
        "model":    model_id,
        "messages": messages,
        "stream":   True,
    }).encode("utf-8")

    req = urllib.request.Request(url, data=payload, headers=headers, method="POST")

    try:
        with urllib.request.urlopen(req, timeout=120) as resp:
            reasoning_chunks = []
            yielded_any = False
            for raw_line in resp:
                line = raw_line.decode("utf-8", errors="replace").strip()
                if not line or line == "data: [DONE]":
                    continue
                if line.startswith("data: "):
                    json_str = line[6:]
                    try:
                        chunk = json.loads(json_str)
                        choices = chunk.get("choices") or []
                        if choices and len(choices) > 0:
                            delta = choices[0].get("delta", {})
                            content = delta.get("content", "")
                            reasoning = delta.get("reasoning_content", "")
                            if reasoning:
                                reasoning_chunks.append(reasoning)
                            if content:
                                yielded_any = True
                                yield content
                    except json.JSONDecodeError:
                        pass

            # Fallback if model only produced reasoning or malformed function call without direct content
            if not yielded_any and reasoning_chunks:
                full_reasoning = "".join(reasoning_chunks).strip()
                if full_reasoning:
                    yield f"*{full_reasoning}*\n\n*(Catatan: Mode chat aktif tanpa eksekusi langsung. Ketik `/agent` untuk menjalankan perintah/inspeksi file otomatis.)*"
    except urllib.error.HTTPError as e:
        body = e.read().decode("utf-8", errors="replace")
        raise RuntimeError(f"HTTP {e.code}: {body}")
    except urllib.error.URLError as e:
        raise RuntimeError(f"Connection error to 9Router: {e.reason}")
    except (socket.timeout, TimeoutError):
        raise RuntimeError("Request timed out waiting for AI response.")


class ThinkingIndicator:
    def __init__(self, text: str = "◓ Reviewing..."):
        self.text = text
        self._live = None

    def __enter__(self):
        spinner = Spinner("dots", text=Text.from_markup(f" [cyan]{self.text}[/cyan]"))
        self._live = Live(spinner, console=console, refresh_per_second=10, transient=True)
        self._live.start()
        return self

    def __exit__(self, *_):
        if self._live:
            self._live.stop()


def render_response(model_id: str, messages: list) -> str:
    """Stream tokens directly without repeating metadata panel."""
    try:
        gen = stream_chat(messages, model_id)
    except Exception as e:
        console.print(f"\n  [red]✗ Error:[/red] {e}\n")
        return ""

    full_text = []
    first_chunk = None
    stream_err = None

    with ThinkingIndicator("◓ Reviewing..."):
        try:
            first_chunk = next(gen)
            full_text.append(first_chunk)
        except StopIteration:
            pass
        except Exception as e:
            stream_err = str(e)

    if stream_err:
        console.print(f"\n  [red]✗ Error:[/red] {stream_err}\n")
        return ""

    if first_chunk:
        console.print("  [bold green]✓ Done[/bold green]\n")
        console.print(first_chunk, end="", markup=False, highlight=False)
        sys.stdout.flush()

    try:
        for chunk in gen:
            full_text.append(chunk)
            console.print(chunk, end="", markup=False, highlight=False)
            sys.stdout.flush()
    except Exception as e:
        console.print(f"\n  [red]✗ Stream interrupted:[/red] {e}")

    if not full_text:
        console.print("\n  [dim yellow]⚠ Model tidak mengembalikan teks jawaban. Coba kirim ulang, beralih ke `/agent` untuk eksekusi perintah, atau pilih model lain dengan `/models`.[/dim yellow]")

    console.print()
    console.print()
    return "".join(full_text)


# ──────────────────────────────────────────────
# Agent Client Execution (Local & Remote)
# ──────────────────────────────────────────────
def run_agent_turn(prompt: str):
    """Execute turn using Agent (locally on current working directory or via remote daemon)."""
    script_dir = os.path.dirname(os.path.abspath(__file__))
    local_agent_path = None

    for cand in ("pips-agent", "pips-agent.py", "pips-agent.cmd"):
        fp = os.path.join(script_dir, cand)
        if os.path.exists(fp):
            local_agent_path = fp
            break

    if not local_agent_path and shutil.which("pips-agent"):
        local_agent_path = shutil.which("pips-agent")

    # If missing locally on client, auto-download pips-agent.py for instant local execution
    if not local_agent_path:
        agent_dest = os.path.join(script_dir, "pips-agent.py")
        sources = [
            "https://raw.githubusercontent.com/cadisetrama86/pips-cli/main/bin/pips-agent",
            "https://pips.dvikara.cloud/pips-agent.py"
        ]
        for src in sources:
            try:
                console.print("  [dim]Downloading Autonomous Agent module...[/dim]")
                req = urllib.request.Request(src, headers={"User-Agent": "pips-cli/2.0"})
                with urllib.request.urlopen(req, timeout=12) as r:
                    content = r.read()
                    if content and len(content) > 1000:
                        with open(agent_dest, "wb") as f:
                            f.write(content)
                        local_agent_path = agent_dest
                        console.print("  [green]✓[/green] [dim]Autonomous Agent ready locally.[/dim]")
                        break
            except Exception:
                pass

    if local_agent_path:
        import subprocess
        if local_agent_path.endswith(".py"):
            subprocess.run([sys.executable, local_agent_path, prompt], cwd=os.getcwd())
        else:
            subprocess.run([local_agent_path, prompt], cwd=os.getcwd())
        return

    # Fallback to Remote Agent Server
    url = f"{PIPS_AGENT_URL}/api/agent/chat"
    headers = {
        "Content-Type": "application/json",
        "Authorization": f"Bearer {API_KEY}",
        "User-Agent": "pips-cli-agent/2.0"
    }
    payload = json.dumps({"prompt": prompt}).encode("utf-8")
    req = urllib.request.Request(url, data=payload, headers=headers, method="POST")

    console.print(f"\n  [bold magenta]🤖 Connecting to VPS Agent at {PIPS_AGENT_URL}...[/bold magenta]\n")

    try:
        with urllib.request.urlopen(req, timeout=120) as resp:
            for raw_line in resp:
                line = raw_line.decode("utf-8", errors="replace").strip()
                if line.startswith("data: "):
                    try:
                        ev = json.loads(line[6:])
                        ev_type = ev.get("type")
                        data = ev.get("data", {})
                        if ev_type == "thought":
                            thought_text = data.get("thought", "").strip()
                            first_line = thought_text.splitlines()[0] if thought_text else ""
                            snippet = first_line[:120] + ("..." if len(first_line) > 120 else "")
                            console.print(f"  [cyan]◓ Reviewing...[/cyan] [dim]{snippet}[/dim]")
                        elif ev_type == "tool_call":
                            name = data.get("name", "")
                            args = data.get("arguments", {})
                            if name == "file_list":
                                target = args.get("path", ".")
                                console.print(f"  [blue]⌕ Searching...[/blue] [white]{target}[/white]")
                            elif name == "file_read":
                                target = args.get("path", "")
                                console.print(f"  [magenta]📖 Reading...[/magenta] [white]{target}[/white]")
                            elif name in ("file_edit", "file_write"):
                                target = args.get("path", "")
                                content_len = len(args.get("content", ""))
                                size_hint = f" [dim]({content_len:,} chars)[/dim]" if content_len else ""
                                console.print(f"  [yellow]✎ Editing...[/yellow] [white]{target}[/white]{size_hint}")
                            else:
                                cmd_info = args.get("command") or args.get("action") or json.dumps(args)
                                console.print(f"  [bold cyan]⚙ Running tool...[/bold cyan] [bold yellow]{name}[/bold yellow] [dim]({cmd_info})[/dim]")
                        elif ev_type == "tool_result":
                            res = data.get("result", {})
                            if res.get("ok"):
                                name = data.get("name", "")
                                if name == "file_list":
                                    summary = f"[dim]found {res.get('total', len(res.get('items', [])))} items[/dim]"
                                elif name == "file_write":
                                    summary = f"[dim]saved {res.get('bytes_written', 0):,} bytes[/dim]"
                                elif name == "file_read":
                                    summary = f"[dim]read {res.get('total_read', 0)} lines[/dim]"
                                elif name == "file_edit":
                                    summary = "[dim]updated content[/dim]"
                                elif name == "bash_run":
                                    summary = f"[dim]exit {res.get('exit_code', 0)} in {res.get('duration_seconds', 0)}s[/dim]"
                                else:
                                    out = res.get("stdout") or str(res)
                                    summary = "[dim]" + out.strip().replace("\n", " ")[:100] + "[/dim]"
                                console.print(f"  [bold green]✓ Done[/bold green] {summary}")
                            else:
                                err = res.get("error", "action failed")
                                console.print(f"  [bold red]✗ Failed:[/bold red] [yellow]{err}[/yellow]")
                        elif ev_type == "final_answer":
                            console.print()
                            console.print(Rule(style="cyan"))
                            console.print()
                            console.print(Markdown(data.get("content", "")))
                            console.print()
                    except json.JSONDecodeError:
                        pass
    except Exception as e:
        console.print(f"  [red]✗ Failed to connect to VPS Agent Server:[/red] {e}\n")


# ──────────────────────────────────────────────
# Slash Commands Handler (Rule 8, 9, 12)
# ──────────────────────────────────────────────
def handle_slash(cmd: str, model_id: str, messages: list, is_agent: bool) -> tuple[str, list, bool, bool]:
    """Handles slash commands. Returns (model_id, messages, should_continue, is_agent)."""
    parts = cmd.strip().split(maxsplit=1)
    command = parts[0].lower()
    arg = parts[1].strip() if len(parts) > 1 else ""

    if command in ("/exit", "/quit", "/q"):
        console.print("\n  [dim]Goodbye.[/dim]\n")
        return model_id, messages, False, is_agent

    elif command in ("/model", "/models"):
        if arg == "--refresh":
            model_service.fetch_models(force=True)
            console.print("  [green]✓[/green] Model catalog refreshed.\n")
            return model_id, messages, True, is_agent

        if arg:
            # Query-based search or direct match
            model_service.fetch_models()
            matched = [
                m for m in model_service.models
                if arg.lower() in m["id"].lower() or arg.lower() in m["name"].lower()
            ]
            if len(matched) == 1:
                new_id = matched[0]["id"]
                console.print(f"  [green]✓[/green] Model switched to [bold]{matched[0]['name']}[/bold] ([dim]{new_id}[/dim])\n")
                return new_id, messages, True, is_agent
            elif len(matched) > 1:
                new_id = interactive_select_model(model_id, search_initial=arg)
                name, _ = ModelService.format_model_metadata(new_id)
                print_chat_header(new_id, is_agent)
                console.print(f"  [green]✓[/green] Model switched to [bold]{name}[/bold]\n")
                return new_id, messages, True, is_agent
            else:
                console.print(f"  [yellow]No model found matching:[/yellow] {arg}\n")
                return model_id, messages, True, is_agent

        # Open interactive selector
        new_id = interactive_select_model(model_id)
        name, _ = ModelService.format_model_metadata(new_id)
        print_chat_header(new_id, is_agent)
        console.print(f"  [green]✓[/green] Model switched to [bold]{name}[/bold]\n")
        return new_id, messages, True, is_agent

    elif command == "/agent":
        is_agent = not is_agent
        print_chat_header(model_id, is_agent)
        status = "[bold green]ENABLED[/bold green]" if is_agent else "[dim]DISABLED (Chat mode)[/dim]"
        console.print(f"  [magenta]🤖 Agent Mode:[/magenta] {status}\n")
        return model_id, messages, True, is_agent

    elif command == "/clear":
        messages_only = [m for m in messages if m.get("role") == "system"]
        print_chat_header(model_id, is_agent)
        console.print("  [dim]Chat history cleared.[/dim]\n")
        return model_id, messages_only, True, is_agent

    elif command == "/history":
        if not messages:
            console.print("  [dim]No history yet.[/dim]\n")
        else:
            console.print()
            for m in messages:
                role = m.get("role")
                if role == "system": continue
                content = m.get("content", "")
                snippet = content[:150] + "..." if len(content) > 150 else content
                if role == "user":
                    console.print(f"  [bold cyan]You >[/bold cyan] {snippet}")
                elif role == "assistant":
                    console.print(f"  [bold green]AI  >[/bold green] {snippet}")
            console.print()
        return model_id, messages, True, is_agent

    elif command == "/status":
        console.print()
        try:
            req = urllib.request.Request(f"{ROUTER_BASE_URL.replace('/v1', '')}/api/health", headers={"Authorization": f"Bearer {API_KEY}"})
            with urllib.request.urlopen(req, timeout=4) as r:
                data = json.loads(r.read())
            online = data.get("ok", True)
            status_text = "[bold green]ONLINE[/bold green]" if online else "[yellow]DEGRADED[/yellow]"
        except Exception:
            status_text = "[red]OFFLINE[/red]"

        lbl, _ = ModelService.format_model_metadata(model_id)
        console.print(Panel(
            Text.from_markup(
                f"[bold cyan]9Router AI Gateway[/bold cyan]: {status_text}\n"
                f"[dim]Endpoint     :[/dim] {ROUTER_BASE_URL}\n"
                f"[dim]Active Model :[/dim] [green]{lbl}[/green] ([dim]{model_id}[/dim])\n"
                f"[dim]Cached Models:[/dim] {len(model_service.models)} models available"
            ),
            border_style="cyan",
            box=box.ROUNDED,
            padding=(0, 2)
        ))
        console.print()
        return model_id, messages, True, is_agent

    elif command == "/help":
        console.print(Panel(
            Text.from_markup(
                "[bold]PIPS CLI Commands[/bold]\n\n"
                "  [cyan]/model[/cyan]          — open interactive model selector\n"
                "  [cyan]/model <name>[/cyan]   — search or switch model by name\n"
                "  [cyan]/models[/cyan]         — open model selector\n"
                "  [cyan]/agent[/cyan]          — toggle Autonomous VPS Agent Mode\n"
                "  [cyan]/clear[/cyan]          — clear chat history\n"
                "  [cyan]/history[/cyan]        — view session messages\n"
                "  [cyan]/status[/cyan]         — check 9Router connectivity\n"
                "  [cyan]/help[/cyan]           — show this help\n"
                "  [cyan]/exit[/cyan]           — quit application"
            ),
            border_style="cyan",
            box=box.ROUNDED,
            padding=(0, 2)
        ))
        return model_id, messages, True, is_agent

    else:
        console.print(f"  [yellow]Unknown command:[/yellow] {command}  (type [bold]/help[/bold])\n")
        return model_id, messages, True, is_agent


# ──────────────────────────────────────────────
# Interactive Chat Session
# ──────────────────────────────────────────────
def run_chat_session(initial_model_id: str = None, start_agent: bool = False):
    global current_model_id
    model_id = initial_model_id or current_model_id
    is_agent = start_agent

    print_chat_header(model_id, is_agent)

    cwd = os.getcwd()
    os_name = "Windows" if sys.platform == "win32" else ("macOS" if sys.platform == "darwin" else "Linux")
    user_name = os.environ.get("USERNAME") or os.environ.get("USER") or "user"

    messages = [
        {
            "role": "system",
            "content": (
                f"You are PIPS AI, a helpful AI coding and system assistant powered by 9Router.\n"
                f"Active environment:\n"
                f"- Working Directory (CWD): {cwd}\n"
                f"- Operating System: {os_name} ({sys.platform})\n"
                f"- Current User: {user_name}\n\n"
                f"Operational Rules:\n"
                f"- You are in interactive terminal chat mode. You do NOT have tool execution in this mode. NEVER produce function calls or tool calls.\n"
                f"- When the user asks to check files, list folders, or run commands (e.g. 'cek ada folder apa aja', 'ls', 'dir'), provide the exact {os_name} terminal commands to run (e.g. PowerShell/CMD commands) with clear explanations.\n"
                f"- Remind the user they can type /agent if they want PIPS to automatically inspect files and execute commands.\n"
                f"- When the user refers to 'path ini', 'folder ini', 'disini', or relative paths, they mean: {cwd}.\n"
                f"- Be concise, direct, and practical."
            )
        }
    ]

    while True:
        prompt_sym = "🤖 agent > " if is_agent else "You > "
        try:
            user_input = input(prompt_sym)
        except (EOFError, KeyboardInterrupt):
            console.print("\n  [dim]Exiting chat session.[/dim]\n")
            break

        user_input = user_input.strip()
        if not user_input:
            continue

        save_history()

        # Handle slash commands
        if user_input.startswith("/"):
            model_id, messages, cont, is_agent = handle_slash(user_input, model_id, messages, is_agent)
            current_model_id = model_id
            if not cont:
                break
            continue

        if is_agent:
            run_agent_turn(user_input)
            continue

        messages.append({"role": "user", "content": user_input})
        response = render_response(model_id, messages)

        if response:
            messages.append({"role": "assistant", "content": response})

    save_history()


# ──────────────────────────────────────────────
# Main CLI Entry Point
# ──────────────────────────────────────────────
def main():
    global current_model_id

    # Warm-up / cache models from 9Router in background or startup
    model_service.fetch_models()
    if model_service.models:
        current_model_id = model_service.models[0]["id"]
        # Find exact base flash model first (prefer ag/gemini-3.8-flash without -medium, -high, -low)
        for m in model_service.models:
            if m["id"] == "ag/gemini-3.8-flash":
                current_model_id = m["id"]
                break
        else:
            for m in model_service.models:
                if "gemini-3.8-flash" in m["id"] and "medium" not in m["id"] and "high" not in m["id"] and "low" not in m["id"]:
                    current_model_id = m["id"]
                    break

    args = sys.argv[1:]

    # One-shot command line handling
    if args:
        first = args[0]
        if first in ("-h", "--help"):
            print("Usage: pips-cli [OPTIONS] [PROMPT]")
            print("\nPIPS CLI — AI Development Companion powered by 9Router.")
            print("\nOptions:")
            print("  chat                      Open interactive chat directly")
            print("  agent, --agent            Launch directly in Autonomous VPS Agent mode")
            print("  models, --models          Open interactive model selector")
            print("  -h, --help                Show this help message and exit")
            print("\nExamples:")
            print("  pips-cli                  Open main menu")
            print("  pips-cli chat             Start chat immediately")
            print("  pips-cli agent            Run autonomous agent")
            print("  pips-cli 'what is docker' Run single query and print result")
            sys.exit(0)
        elif first in ("chat", "--chat"):
            run_chat_session(current_model_id)
            sys.exit(0)
        elif first in ("agent", "--agent", "-a"):
            prompt = " ".join(args[1:]) if len(args) > 1 else None
            if prompt:
                run_agent_turn(prompt)
            else:
                run_chat_session(current_model_id, start_agent=True)
            sys.exit(0)
        elif first in ("models", "--models", "--select"):
            chosen = interactive_select_model(current_model_id)
            current_model_id = chosen
            name, _ = ModelService.format_model_metadata(chosen)
            console.print(f"\n  [green]✓[/green] Active model set to: [bold]{name}[/bold] ([dim]{chosen}[/dim])\n")
            sys.exit(0)
        else:
            # One-shot query mode
            one_shot_prompt = " ".join(args)
            cwd = os.getcwd()
            os_name = "Windows" if sys.platform == "win32" else "Linux"
            msgs = [
                {
                    "role": "system",
                    "content": (
                        f"You are PIPS AI. Active CWD: {cwd} on {os_name}. "
                        f"You are in terminal mode without tool execution; provide direct explanations and exact commands."
                    )
                },
                {"role": "user", "content": one_shot_prompt}
            ]
            render_response(current_model_id, msgs)
            sys.exit(0)

    # If stdin is not a TTY (pipe mode), directly open chat
    if not sys.stdin.isatty():
        run_chat_session(current_model_id)
        sys.exit(0)

    # Interactive Main Menu Loop (Rule 6)
    while True:
        action = show_main_screen()

        if action == "chat":
            run_chat_session(current_model_id)
        elif action == "models":
            chosen = interactive_select_model(current_model_id)
            current_model_id = chosen
            name, _ = ModelService.format_model_metadata(chosen)
            console.print(f"\n  [green]✓[/green] Selected: [bold]{name}[/bold]")
            time.sleep(0.8)
        elif action == "agents":
            run_chat_session(current_model_id, start_agent=True)
        elif action == "history":
            console.clear()
            console.print(Panel("[bold]Recent Input History[/bold]", border_style="cyan"))
            if os.path.exists(HISTORY_FILE):
                with open(HISTORY_FILE, "r", encoding="utf-8", errors="replace") as f:
                    hist_lines = [l.strip() for l in f.readlines() if l.strip()][-15:]
                for h in hist_lines:
                    console.print(f"  [dim]•[/dim] {h}")
            else:
                console.print("  [dim]No history file yet.[/dim]")
            console.print("\n[dim]Press Enter to return to main menu...[/dim]")
            read_single_key()
        elif action == "settings":
            console.clear()
            console.print(Panel(
                Text.from_markup(
                    f"[bold]PIPS CLI Configuration[/bold]\n\n"
                    f"[dim]9Router Gateway :[/dim] [cyan]{ROUTER_BASE_URL}[/cyan]\n"
                    f"[dim]Agent Service   :[/dim] [cyan]{PIPS_AGENT_URL}[/cyan]\n"
                    f"[dim]Active Model    :[/dim] [green]{current_model_id}[/green]\n"
                    f"[dim]API Key         :[/dim] {API_KEY[:8]}...{API_KEY[-4:] if len(API_KEY)>12 else ''}\n"
                    f"[dim]Working Dir     :[/dim] [yellow]{os.getcwd()}[/yellow]"
                ),
                border_style="cyan",
                box=box.ROUNDED,
                padding=(1, 2)
            ))
            console.print("[dim]Press Enter to return to main menu...[/dim]")
            read_single_key()
        elif action == "exit":
            console.print("\n[dim]Goodbye![/dim]\n")
            break


if __name__ == "__main__":
    main()
