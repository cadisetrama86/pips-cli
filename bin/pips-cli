def print_header(model_id: str, is_agent: bool = False):
    model_name = model_id
    model_desc = ""
    for k, (mid, mname, mdesc) in MODELS.items():
        if mid == model_id:
            model_name = mname
            model_desc = mdesc
            break

    ascii_lines = PIPS_ASCII.strip("\n").splitlines()
    ascii_text = "\n".join(f"[bold cyan]{line}[/bold cyan]" for line in ascii_lines)

    mode_label = "[bold magenta]🤖 AGENT MODE (VPS Control Active)[/bold magenta]" if is_agent else "[dim]Personal AI Infrastructure & Pipeline Server[/dim]"

    console.print()
    console.print(Panel(
        Text.from_markup(
            f"{ascii_text}\n\n"
            f"{mode_label}\n\n"
            f"[dim]Model   :[/dim] [bold green]{model_name}[/bold green]  [dim]{model_desc}[/dim]\n"
            f"[dim]Model ID:[/dim] [blue]{model_id}[/blue]\n\n"
            f"[dim]Type [/dim][bold]/help[/bold][dim] for commands  •  [/dim][bold]/agent[/bold][dim] to toggle agent  •  [/dim][bold]/exit[/bold][dim] to quit[/dim]"
        ),
        border_style="cyan" if not is_agent else "magenta",
        padding=(1, 2),
    ))
    console.print()


# ──────────────────────────────────────────────
# Model selector
# ──────────────────────────────────────────────
def select_model(current_model: str = DEFAULT_MODEL_ID) -> str:
    console.print(Panel(
        "[bold cyan]Select Model[/bold cyan]",
        border_style="cyan",
        padding=(0, 1),
    ))
    console.print()

    for k, (mid, mname, mdesc) in MODELS.items():
        active = "●" if mid == current_model else " "
        console.print(f"  [cyan]{k}[/cyan]  [green]{active}[/green]  [white]{mname}[/white]  [dim]{mdesc}[/dim]")

    console.print()
    console.print(f"  [dim]Press Enter for default ([/dim][green]{DEFAULT_MODEL_ID}[/green][dim])[/dim]")
    console.print()

    try:
        choice = input("  Select [1-9]: ").strip()
    except (EOFError, KeyboardInterrupt):
        return current_model

    if choice in MODELS:
        selected_id = MODELS[choice][0]
        console.print(f"\n  [green]✓[/green] Selected: [bold]{MODELS[choice][1]}[/bold]\n")
        return selected_id

    return current_model


# ──────────────────────────────────────────────
# Stream chat (Zero external deps, Robust SSE)
# ──────────────────────────────────────────────
def stream_chat(messages: list, model_id: str):
    """Stream response from 9Router, yields tokens safely."""
    url = f"{PIPS_BASE_URL}/chat/completions"
    headers = {
        "Content-Type":  "application/json",
        "Authorization": f"Bearer {API_KEY}",
        "Accept":        "text/event-stream",
        "User-Agent":    "pips-cli/2.0",
    }
    payload = json.dumps({
        "model":    model_id,
        "messages": messages,
        "stream":   True,
    }).encode("utf-8")

    req = urllib.request.Request(url, data=payload, headers=headers, method="POST")

    try:
        with urllib.request.urlopen(req, timeout=120) as resp:
            for raw_line in resp:
                line = raw_line.decode("utf-8", errors="replace").strip()
                if not line or line == "data: [DONE]":
                    continue
                if line.startswith("data: "):
                    json_str = line[6:]
                    try:
                        chunk = json.loads(json_str)
                        choices = chunk.get("choices") or []
                        if choices and len(choices) > 0:
                            delta = choices[0].get("delta", {})
                            content = delta.get("content", "")
                            if content:
                                yield content
                    except json.JSONDecodeError:
                        pass
    except urllib.error.HTTPError as e:
        body = e.read().decode("utf-8", errors="replace")
        raise RuntimeError(f"HTTP {e.code}: {body}")
    except urllib.error.URLError as e:
        raise RuntimeError(f"Connection error: {e.reason}")
    except (socket.timeout, TimeoutError):
        raise RuntimeError("Request timed out while waiting for AI response.")


# ──────────────────────────────────────────────
# Thinking indicator
# ──────────────────────────────────────────────
class ThinkingIndicator:
    def __init__(self):
        self._live = None

    def __enter__(self):
        spinner = Spinner("dots", text=Text.from_markup(" [dim]Thinking...[/dim]"))
        self._live = Live(spinner, console=console, refresh_per_second=10, transient=True)
        self._live.start()
        return self

    def __exit__(self, *_):
        if self._live:
            self._live.stop()


# ──────────────────────────────────────────────
# Render response (No token loss, No double print)
# ──────────────────────────────────────────────
def render_response(model_id: str, messages: list) -> str:
    """Show thinking spinner, then stream cleanly without duplicate panels."""
    model_label = model_id
    for k, (mid, mname, _) in MODELS.items():
        if mid == model_id:
            model_label = mname
            break

    console.print()
    console.print(f"  [bold cyan]●[/bold cyan] [dim]{model_label}[/dim]\n")

    try:
        gen = stream_chat(messages, model_id)
    except Exception as e:
        console.print(f"  [red]✗ Error:[/red] {e}\n")
        return ""

    full_text = []

    # Wait for first token under spinner
    first_chunk = None
    with ThinkingIndicator():
        try:
            first_chunk = next(gen)
            full_text.append(first_chunk)
        except StopIteration:
            pass
        except RuntimeError as e:
            console.print(f"  [red]✗ Error:[/red] {e}\n")
            return ""

    # Print first token immediately
    if first_chunk:
        console.print(first_chunk, end="", markup=False, highlight=False)
        sys.stdout.flush()

    # Stream the rest of response
    try:
        for chunk in gen:
            full_text.append(chunk)
            console.print(chunk, end="", markup=False, highlight=False)
            sys.stdout.flush()
    except Exception as e:
        console.print(f"\n  [red]✗ Stream interrupted:[/red] {e}")

    console.print()
    console.print()
    return "".join(full_text)


# ──────────────────────────────────────────────
# Agent Client Integration (Local & Remote)
# ──────────────────────────────────────────────
def run_agent_turn(prompt: str, is_local_vps: bool = False):
    """Execute turn using VPS Agent (either directly or via Agent Server)."""
    # Check if local pips-agent script exists on this machine
    local_agent_path = os.path.join(os.path.dirname(os.path.abspath(__file__)), "pips-agent")
    if os.path.exists(local_agent_path):
        import subprocess
        proc = subprocess.run([local_agent_path, prompt])
        return

    # Otherwise stream from remote Agent Server
    url = f"{PIPS_AGENT_URL}/api/agent/chat"
    headers = {
        "Content-Type": "application/json",
        "Authorization": f"Bearer {API_KEY}",
        "User-Agent": "pips-cli-agent/2.0"
    }
    payload = json.dumps({"prompt": prompt}).encode("utf-8")
    req = urllib.request.Request(url, data=payload, headers=headers, method="POST")

    console.print(f"\n  [bold magenta]🤖 Connecting to VPS Agent at {PIPS_AGENT_URL}...[/bold magenta]\n")

    try:
        with urllib.request.urlopen(req, timeout=120) as resp:
            for raw_line in resp:
                line = raw_line.decode("utf-8", errors="replace").strip()
                if line.startswith("data: "):
                    try:
                        ev = json.loads(line[6:])
                        ev_type = ev.get("type")
                        data = ev.get("data", {})
                        if ev_type == "thought":
                            console.print(f"  [dim italic]💭 Thinking: {data.get('thought', '').strip()}[/dim italic]")
                        elif ev_type == "tool_call":
                            name = data.get("name", "")
                            args = json.dumps(data.get("arguments", {}))
                            console.print(f"\n  [bold cyan]⚙ VPS Executing:[/bold cyan] [bold yellow]{name}[/bold yellow] {args}")
                        elif ev_type == "tool_result":
                            res = data.get("result", {})
                            out = res.get("stdout") or str(res)
                            snippet = out.strip()[:250] + ("..." if len(out) > 250 else "")
                            console.print(f"  [bold green]✓ Result:[/bold green] [dim]{snippet}[/dim]")
                        elif ev_type == "final_answer":
                            console.print()
                            console.print(Rule(style="cyan"))
                            console.print()
                            console.print(Markdown(data.get("content", "")))
                            console.print()
                    except json.JSONDecodeError:
                        pass
    except Exception as e:
        console.print(f"  [red]✗ Failed to connect to VPS Agent Server:[/red] {e}")
        console.print(f"  [dim]Make sure 'pips-agent serve' is running on your VPS, or check PIPS_AGENT_URL[/dim]\n")


# ──────────────────────────────────────────────
# Slash commands
# ──────────────────────────────────────────────
def handle_slash(cmd: str, model_id: str, messages: list, is_agent: bool) -> tuple[str, list, bool, bool]:
    """Returns (model_id, messages, should_continue, is_agent)"""
    parts = cmd.strip().split(maxsplit=1)
    command = parts[0].lower()

    if command in ("/exit", "/quit", "/q"):
        console.print("\n  [dim]Goodbye.[/dim]\n")
        return model_id, messages, False, is_agent

    elif command == "/help":
        console.print(Panel(
            Text.from_markup(
                "[bold]PIPS CLI Commands[/bold]\n\n"
                "  [cyan]/model[/cyan]         — switch AI model\n"
                "  [cyan]/models[/cyan]        — list available models\n"
                "  [cyan]/agent[/cyan]         — toggle Autonomous VPS Agent Mode\n"
                "  [cyan]/clear[/cyan]         — clear chat history\n"
                "  [cyan]/history[/cyan]       — show current conversation\n"
                "  [cyan]/status[/cyan]        — check 9Router & VPS Agent status\n"
                "  [cyan]/help[/cyan]          — show this help\n"
                "  [cyan]/exit[/cyan]          — exit pips-cli\n\n"
                "[dim]Tip: Use ↑↓ arrow keys to navigate history[/dim]"
            ),
            border_style="cyan",
            padding=(0, 2),
        ))
        return model_id, messages, True, is_agent

    elif command == "/agent":
        is_agent = not is_agent
        status = "[bold green]ENABLED[/bold green]" if is_agent else "[dim]DISABLED (Chat mode)[/dim]"
        console.print(f"\n  [magenta]🤖 Agent Mode:[/magenta] {status}\n")
        return model_id, messages, True, is_agent

    elif command == "/model":
        console.print()
        new_model = select_model(model_id)
        console.print(f"  [green]✓[/green] Model switched to [bold]{new_model}[/bold]\n")
        return new_model, messages, True, is_agent

    elif command == "/models":
        console.print()
        console.print("  [bold]Available Models:[/bold]\n")
        for k, (mid, mname, mdesc) in MODELS.items():
            active = "[green]●[/green]" if mid == model_id else " "
            console.print(f"  {active} [cyan]{k}[/cyan]  [white]{mname}[/white]  [dim]{mdesc}[/dim]")
            console.print(f"     [dim]{mid}[/dim]")
        console.print()
        return model_id, messages, True, is_agent

    elif command == "/clear":
        messages_only = [m for m in messages if m["role"] == "system"]
        console.clear()
        print_header(model_id, is_agent)
        console.print("  [dim]Chat history cleared.[/dim]\n")
        return model_id, messages_only, True, is_agent

    elif command == "/history":
        if not messages:
            console.print("  [dim]No history yet.[/dim]\n")
        else:
            console.print()
            for m in messages:
                role = m.get("role")
                if role == "system":
                    continue
                content = m.get("content", "")
                snippet = content[:150] + "..." if len(content) > 150 else content
                if role == "user":
                    console.print(f"  [bold cyan]You:[/bold cyan] {snippet}")
                elif role == "assistant":
                    console.print(f"  [bold green]AI:[/bold green]  {snippet}")
            console.print()
        return model_id, messages, True, is_agent

    elif command == "/status":
        console.print()
        # Health check
        try:
            health_url = PIPS_BASE_URL.replace("/v1", "") + "/api/health"
            req = urllib.request.Request(health_url, headers={"Authorization": f"Bearer {API_KEY}"})
            with urllib.request.urlopen(req, timeout=5) as r:
                data = json.loads(r.read())
            if data.get("ok"):
                console.print(f"  [green]✓[/green] 9Router Gateway: [bold green]ONLINE[/bold green]")
            else:
                console.print(f"  [yellow]⚠[/yellow] 9Router Gateway: [yellow]DEGRADED[/yellow]")
        except Exception as e:
            console.print(f"  [red]✗[/red] 9Router Gateway: [red]OFFLINE[/red] ({e})")

        # VPS Agent Health check
        try:
            agent_req = urllib.request.Request(f"{PIPS_AGENT_URL}/health", headers={"Authorization": f"Bearer {API_KEY}"})
            with urllib.request.urlopen(agent_req, timeout=3) as r:
                adata = json.loads(r.read())
            if adata.get("ok"):
                console.print(f"  [green]✓[/green] VPS Agent Server: [bold green]ONLINE ({PIPS_AGENT_URL})[/bold green]")
            else:
                console.print(f"  [yellow]⚠[/yellow] VPS Agent Server: [yellow]DEGRADED[/yellow]")
        except Exception:
            console.print(f"  [dim]•[/dim] VPS Agent Server: [dim]NOT REACHABLE AT {PIPS_AGENT_URL}[/dim]")

        model_name = next((v[1] for v in MODELS.values() if v[0] == model_id), model_id)
        console.print(f"  [dim]Gateway URL : {PIPS_BASE_URL}[/dim]")
        console.print(f"  [dim]Active Model: {model_name} ({model_id})[/dim]\n")
        return model_id, messages, True, is_agent

    else:
        console.print(f"  [yellow]Unknown command:[/yellow] {command}  (type [bold]/help[/bold])\n")
        return model_id, messages, True, is_agent


# ──────────────────────────────────────────────
# Input prompt
# ──────────────────────────────────────────────
def get_input(is_agent: bool = False) -> str:
    console.print(Rule(style="magenta" if is_agent else "dim"))
    prompt_sym = "  [magenta]🤖 agent ❯[/magenta] " if is_agent else "  ❯ "
    try:
        text = input(Text.from_markup(prompt_sym).plain)
    except (EOFError, KeyboardInterrupt):
        return "/exit"
    return text.strip()


# ──────────────────────────────────────────────
# Main CLI Loop
# ──────────────────────────────────────────────
def main():
    # ── Parse CLI Arguments ──
    args = sys.argv[1:]
    is_agent = False
    model_id = DEFAULT_MODEL_ID
    one_shot_prompt = None

    if args:
        first = args[0]
        if first in ("-h", "--help"):
            print("Usage: pips-cli [OPTIONS] [PROMPT]")
            print("\nInteractive AI chat and Autonomous VPS Agent CLI.")
            print("\nOptions:")
            print("  --select                  Choose model before starting")
            print("  agent, --agent            Launch directly in Autonomous VPS Agent mode")
            print("  -h, --help                Show this help message and exit")
            print("  <1-9>                     Select model number directly (e.g. 'pips-cli 4')")
            print("  <model-id>                Use specific model (e.g. 'pips-cli ag/claude-sonnet-4-6')")
            print("\nExamples:")
            print("  pips-cli                  Start interactive chat with default model")
            print("  pips-cli agent            Control your VPS with the autonomous agent")
            print("  pips-cli 4                Start chat using Claude Sonnet 4.6")
            print("  pips-cli 'what is docker' Run single query and print result")
            sys.exit(0)
        elif first in ("agent", "--agent", "-a"):
            is_agent = True
            if len(args) > 1:
                one_shot_prompt = " ".join(args[1:])
        elif first == "--select":
            model_id = select_model()
        elif first in MODELS:
            model_id = MODELS[first][0]
            if len(args) > 1:
                one_shot_prompt = " ".join(args[1:])
        elif first in [m[0] for m in MODELS.values()]:
            model_id = first
            if len(args) > 1:
                one_shot_prompt = " ".join(args[1:])
        else:
            # One shot prompt
            one_shot_prompt = " ".join(args)

    if one_shot_prompt:
        if is_agent:
            run_agent_turn(one_shot_prompt)
        else:
            msgs = [
                {"role": "system", "content": "You are PIPS AI, a helpful and precise assistant. Format answers clearly with markdown."},
                {"role": "user", "content": one_shot_prompt}
            ]
            render_response(model_id, msgs)
        sys.exit(0)

    # Interactive mode
    console.clear()
    print_header(model_id, is_agent)

    messages = [
        {
            "role": "system",
            "content": (
                "You are PIPS AI, a helpful assistant powered by the PIPS personal AI infrastructure. "
                "Be concise, precise, and helpful. When writing code, use proper formatting."
            )
        }
    ]

    while True:
        try:
            user_input = get_input(is_agent)
        except KeyboardInterrupt:
            console.print("\n  [dim]Use /exit to quit.[/dim]\n")
            continue

        if not user_input:
            continue

        save_history()

        # Handle slash commands
        if user_input.startswith("/"):
            model_id, messages, cont, is_agent = handle_slash(user_input, model_id, messages, is_agent)
            if not cont:
                break
            continue

        if is_agent:
            run_agent_turn(user_input)
            continue

        # Regular Chat Mode
        console.print()
        console.print(f"  [bold white]You[/bold white]")
        console.print(f"  {user_input}")

        messages.append({"role": "user", "content": user_input})
        response = render_response(model_id, messages)

        if response:
            messages.append({"role": "assistant", "content": response})

    save_history()
    console.print()


if __name__ == "__main__":
    main()
