# ──────────────────────────────────────────────
# Load Environment (~/.pips/pips.env)
# ──────────────────────────────────────────────
def load_env():
    pips_env = os.path.expanduser("~/.pips/pips.env")
    if os.path.exists(pips_env):
        with open(pips_env, "r", encoding="utf-8") as f:
            for line in f:
                line = line.strip()
                if line and not line.startswith("#") and "=" in line:
                    k, _, v = line.partition("=")
                    clean_val = v.strip().strip("'\"")
                    os.environ.setdefault(k.strip(), clean_val)

load_env()

