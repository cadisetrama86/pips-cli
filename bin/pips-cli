def show_main_screen() -> str:
    """Render dark crimson gothic main menu with stylized banner."""
    menu_items = [
        ("chat",     "Chat",     "Interactive AI chat"),
        ("models",   "Models",   "Discover & switch AI model"),
        ("agents",   "Agents",   "Autonomous VPS Agent mode"),
        ("preview",  "Preview",  "Launch local web preview server"),
        ("history",  "History",  "View conversation history"),
        ("settings", "Settings", "View connection & endpoint info"),
        ("update",   "Update",   "Check and install latest update"),
        ("exit",     "Exit",     "Quit PIPS CLI")
    ]
    selected_idx = 0

    while True:
        lines = [""]
        for line, col in SKULL_BANNER:
            lines.append(f"  [{col}]{line}[/{col}]")
        lines.append("")
        for line, col in LOGO_BANNER:
            lines.append(f"  [{col}]{line}[/{col}]")
        lines.append("")
        lines.append("       [bold #ff3344][ CRIMSON PROTOCOL :: ONLINE ][/bold #ff3344]")
        lines.append("  [dim #551111]─────────────────────────────────────────────────[/dim #551111]")
        lines.append("")
        lines.append("  [bold white]Command Selection:[/bold white]")
        lines.append("")

        for i, (key, label, desc) in enumerate(menu_items):
            if i == selected_idx:
                lines.append(f"  [bold #ff2244]◈ {label}[/bold #ff2244]  [dim #cccccc]— {desc}[/dim #cccccc]")
            else:
                lines.append(f"    [dim #888888]{label}[/dim #888888]")

        lines.append("")
        content = Text.from_markup("\n".join(lines))

        console.clear()
        console.print(Panel(
            content,
            border_style="#cc0029",
            box=box.ROUNDED,
            padding=(0, 2)
        ))
        console.print("  [dim #777777]↑↓ Navigate   Enter Select   Ctrl+C Exit[/dim #777777]")

        try:
            key = read_single_key()
        except KeyboardInterrupt:
            return "exit"

        if key == 'UP':
            selected_idx = (selected_idx - 1) % len(menu_items)
        elif key == 'DOWN':
            selected_idx = (selected_idx + 1) % len(menu_items)
        elif key == 'ENTER':
            return menu_items[selected_idx][0]
        elif key == 'ESC':
            return "exit"


# ──────────────────────────────────────────────
# Chat Header (Rule 7)
# ──────────────────────────────────────────────
def print_chat_header(model_id: str, is_agent: bool = False):
    """Prints a minimal, clean one-line header in dark crimson theme."""
    label, _ = ModelService.format_model_metadata(model_id)
    mode_text = " [bold #ff4d4d]• 💀 AGENT[/bold #ff4d4d]" if is_agent else " [bold #ff4d4d]• CRIMSON[/bold #ff4d4d]"

    console.clear()
    header_title = f" PIPS CLI{mode_text} ─── {label} "
    console.print(Panel(
        "",
        title=f"[bold #ff3344]{header_title}[/bold #ff3344]",
        title_align="center",
        border_style="#cc0029",
        box=box.ROUNDED,
        height=3
    ))


# ──────────────────────────────────────────────
# Stream Chat Response (Urllib / SSE / Local Acceleration)
# ──────────────────────────────────────────────
def stream_chat(messages: list, target_model: str, is_local_direct: bool = False):
    """Stream response from Ollama direct or 9Router, yielding tokens safely with auto-fallback."""
    if is_local_direct:
        # Try local direct stream first (0 cloud token overhead, 100% free)
        url = f"{OLLAMA_BASE_URL}/v1/chat/completions"
        headers = {
            "Content-Type": "application/json",
            "Accept": "text/event-stream",
            "User-Agent": "pips-cli/2.0",
        }
        payload = json.dumps({
            "model": target_model,
            "messages": messages,
            "stream": True,
        }).encode("utf-8")

        req = urllib.request.Request(url, data=payload, headers=headers, method="POST")
        try:
            with urllib.request.urlopen(req, timeout=90) as resp:
                for raw_line in resp:
                    line = raw_line.decode("utf-8", errors="replace").strip()
                    if not line or line == "data: [DONE]":
                        continue
                    if line.startswith("data: "):
                        json_str = line[6:]
                        try:
                            chunk = json.loads(json_str)
                            choices = chunk.get("choices") or []
                            if choices and len(choices) > 0:
                                delta = choices[0].get("delta", {})
                                content = delta.get("content", "")
                                if content:
                                    yield content
                        except json.JSONDecodeError:
                            pass
            return
        except Exception:
            # If local Ollama connection fails or runner crashed, smoothly fallback to cloud gateway
            target_model = "ag/gemini-3.8-flash"
            is_local_direct = False

    # Standard 9Router Cloud upstream
    url = f"{ROUTER_BASE_URL}/chat/completions"
    headers = {
        "Content-Type":  "application/json",
        "Authorization": f"Bearer {API_KEY}",
        "Accept":        "text/event-stream",
        "User-Agent":    "pips-cli/2.0",
    }
    payload = json.dumps({
        "model":    target_model,
        "messages": messages,
        "stream":   True,
    }).encode("utf-8")

    req = urllib.request.Request(url, data=payload, headers=headers, method="POST")

    try:
        with urllib.request.urlopen(req, timeout=120) as resp:
            reasoning_chunks = []
            yielded_any = False
            for raw_line in resp:
                line = raw_line.decode("utf-8", errors="replace").strip()
                if not line or line == "data: [DONE]":
                    continue
                if line.startswith("data: "):
                    json_str = line[6:]
                    try:
                        chunk = json.loads(json_str)
                        choices = chunk.get("choices") or []
                        if choices and len(choices) > 0:
                            delta = choices[0].get("delta", {})
                            content = delta.get("content", "")
                            reasoning = delta.get("reasoning_content", "")
                            if reasoning:
                                reasoning_chunks.append(reasoning)
                            if content:
                                yielded_any = True
                                yield content
                    except json.JSONDecodeError:
                        pass

            # Fallback if model only produced reasoning or malformed function call without direct content
            if not yielded_any and reasoning_chunks:
                full_reasoning = "".join(reasoning_chunks).strip()
                if full_reasoning:
                    yield f"*{full_reasoning}*\n\n*(Catatan: Mode chat aktif tanpa eksekusi langsung. Ketik `/agent` untuk menjalankan perintah/inspeksi file otomatis.)*"
    except urllib.error.HTTPError as e:
        body = e.read().decode("utf-8", errors="replace")
        raise RuntimeError(f"HTTP {e.code}: {body}")
    except urllib.error.URLError as e:
        raise RuntimeError(f"Connection error to 9Router: {e.reason}")
    except (socket.timeout, TimeoutError):
        raise RuntimeError("Request timed out waiting for AI response.")


class ThinkingIndicator:
    def __init__(self, text: str = "◓ Reviewing..."):
        self.text = text
        self._live = None

    def __enter__(self):
        spinner = Spinner("dots", text=Text.from_markup(f" [bold #ff4d4d]{self.text}[/bold #ff4d4d]"), style="#ff3344")
        self._live = Live(spinner, console=console, refresh_per_second=10, transient=True)
        self._live.start()
        return self

    def __exit__(self, *_):
        if self._live:
            self._live.stop()


def render_response(model_id: str, messages: list) -> str:
    """Stream tokens directly with smart hybrid route resolution & token metric tracking."""
    target_model, is_local_direct, route_badge = auto_router.resolve_route(messages, model_id)
    active_msgs = token_optimizer.optimize_messages(messages, target_model, is_local=is_local_direct)

    # Calculate input prompt tokens
    prompt_chars = sum(len(m.get("content", "")) for m in active_msgs)
    in_tokens = max(1, prompt_chars // 4)

    try:
        gen = stream_chat(active_msgs, target_model, is_local_direct=is_local_direct)
    except Exception as e:
        console.print(f"\n  [bold red]✗ Error:[/bold red] {e}\n")
        return ""

    full_text = []
    first_chunk = None
    stream_err = None

    indicator_text = f"◓ [{route_badge}] Reviewing..."
    with ThinkingIndicator(indicator_text):
        try:
            first_chunk = next(gen)
            full_text.append(first_chunk)
        except StopIteration:
            pass
        except Exception as e:
            stream_err = str(e)

    if stream_err:
        console.print(f"\n  [bold red]✗ Error:[/bold red] {stream_err}\n")
        return ""

    if first_chunk:
        console.print(f"  [bold #ff3344]✓ Done[/bold #ff3344] [dim]({route_badge})[/dim]\n")
        console.print(first_chunk, end="", markup=False, highlight=False)
        sys.stdout.flush()

    try:
        for chunk in gen:
            full_text.append(chunk)
            console.print(chunk, end="", markup=False, highlight=False)
            sys.stdout.flush()
    except Exception as e:
        console.print(f"\n  [red]✗ Stream interrupted:[/red] {e}")

    ans = "".join(full_text)
    if not ans:
        console.print("\n  [dim yellow]⚠ Model tidak mengembalikan teks jawaban. Coba kirim ulang, beralih ke `/agent` untuk eksekusi perintah, atau pilih model lain dengan `/models`.[/dim yellow]")
    else:
        out_tokens = max(1, len(ans) // 4)
        if is_local_direct:
            token_optimizer.local_queries_count += 1
            # Local computation saves 100% of prompt + completion tokens from cloud billing
            token_optimizer.saved_tokens_est += (in_tokens + out_tokens)
        else:
            token_optimizer.cloud_queries_count += 1
            token_optimizer.prompt_tokens_est += in_tokens
            token_optimizer.completion_tokens_est += out_tokens

    console.print()
    console.print()
    return ans


# ──────────────────────────────────────────────
# Agent Client Execution (Local & Remote)
# ──────────────────────────────────────────────
def run_agent_turn(prompt: str):
    """Execute turn using Agent (locally on current working directory or via remote daemon)."""
    script_dir = os.path.dirname(os.path.abspath(__file__))
    local_agent_path = None

    for cand in ("pips-agent", "pips-agent.py", "pips-agent.cmd"):
        fp = os.path.join(script_dir, cand)
        if os.path.exists(fp):
            local_agent_path = fp
            break

    if not local_agent_path and shutil.which("pips-agent"):
        local_agent_path = shutil.which("pips-agent")

    # If missing locally on client, auto-download pips-agent.py for instant local execution
    if not local_agent_path:
        agent_dest = os.path.join(script_dir, "pips-agent.py")
        sources = [
            "https://raw.githubusercontent.com/cadisetrama86/pips-cli/main/bin/pips-agent",
            "https://pips.dvikara.cloud/pips-agent.py"
        ]
        for src in sources:
            try:
                console.print("  [dim]Downloading Autonomous Agent module...[/dim]")
                req = urllib.request.Request(src, headers={"User-Agent": "pips-cli/2.0"})
                with urllib.request.urlopen(req, timeout=12) as r:
                    content = r.read()
                    if content and len(content) > 1000:
                        with open(agent_dest, "wb") as f:
                            f.write(content)
                        local_agent_path = agent_dest
                        console.print("  [green]✓[/green] [dim]Autonomous Agent ready locally.[/dim]")
                        break
            except Exception:
                pass

    if local_agent_path:
        import subprocess
        if local_agent_path.endswith(".py"):
            subprocess.run([sys.executable, local_agent_path, prompt], cwd=os.getcwd())
        else:
            subprocess.run([local_agent_path, prompt], cwd=os.getcwd())
        return

    # Fallback to Remote Agent Server
    url = f"{PIPS_AGENT_URL}/api/agent/chat"
    headers = {
        "Content-Type": "application/json",
        "Authorization": f"Bearer {API_KEY}",
        "User-Agent": "pips-cli-agent/2.0"
    }
    payload = json.dumps({"prompt": prompt}).encode("utf-8")
    req = urllib.request.Request(url, data=payload, headers=headers, method="POST")

    console.print(f"\n  [bold #ff3344]💀 Connecting to VPS Agent at {PIPS_AGENT_URL}...[/bold #ff3344]\n")

    try:
        with urllib.request.urlopen(req, timeout=120) as resp:
            for raw_line in resp:
                line = raw_line.decode("utf-8", errors="replace").strip()
                if line.startswith("data: "):
                    try:
                        ev = json.loads(line[6:])
                        ev_type = ev.get("type")
                        data = ev.get("data", {})
                        if ev_type == "thought":
                            thought_text = data.get("thought", "").strip()
                            first_line = thought_text.splitlines()[0] if thought_text else ""
                            snippet = first_line[:120] + ("..." if len(first_line) > 120 else "")
                            console.print(f"  [bold #ff4d4d]◓ Reviewing...[/bold #ff4d4d] [dim]{snippet}[/dim]")
                        elif ev_type == "tool_call":
                            name = data.get("name", "")
                            args = data.get("arguments", {})
                            if name == "file_list":
                                target = args.get("path", ".")
                                console.print(f"  [#ff4757]⌕ Searching...[/#ff4757] [white]{target}[/white]")
                            elif name == "file_read":
                                target = args.get("path", "")
                                console.print(f"  [#ff6b81]📖 Reading...[/#ff6b81] [white]{target}[/white]")
                            elif name in ("file_edit", "file_write"):
                                target = args.get("path", "")
                                content_len = len(args.get("content", ""))
                                size_hint = f" [dim]({content_len:,} chars)[/dim]" if content_len else ""
                                console.print(f"  [#ff9f43]✎ Editing...[/#ff9f43] [white]{target}[/white]{size_hint}")
                            else:
                                cmd_info = args.get("command") or args.get("action") or json.dumps(args)
                                console.print(f"  [bold #ff3344]⚙ Running tool...[/bold #ff3344] [bold #ffa502]{name}[/bold #ffa502] [dim]({cmd_info})[/dim]")
                        elif ev_type == "tool_result":
                            res = data.get("result", {})
                            if res.get("ok"):
                                name = data.get("name", "")
                                if name == "file_list":
                                    summary = f"[dim]found {res.get('total', len(res.get('items', [])))} items[/dim]"
                                elif name == "file_write":
                                    summary = f"[dim]saved {res.get('bytes_written', 0):,} bytes[/dim]"
                                elif name == "file_read":
                                    summary = f"[dim]read {res.get('total_read', 0)} lines[/dim]"
                                elif name == "file_edit":
                                    summary = "[dim]updated content[/dim]"
                                elif name == "bash_run":
                                    summary = f"[dim]exit {res.get('exit_code', 0)} in {res.get('duration_seconds', 0)}s[/dim]"
                                else:
                                    out = res.get("stdout") or str(res)
                                    summary = "[dim]" + out.strip().replace("\n", " ")[:100] + "[/dim]"
                                console.print(f"  [bold green]✓ Done[/bold green] {summary}")
                            else:
                                err = res.get("error", "action failed")
                                console.print(f"  [bold red]✗ Failed:[/bold red] [yellow]{err}[/yellow]")
                        elif ev_type == "final_answer":
                            console.print()
                            console.print(Rule(style="#cc0029"))
                            console.print()
                            console.print(Markdown(data.get("content", "")))
                            console.print()
                    except json.JSONDecodeError:
                        pass
    except Exception as e:
        console.print(f"  [red]✗ Failed to connect to VPS Agent Server:[/red] {e}\n")


# ──────────────────────────────────────────────
# Local Preview Server (/preview, pips-cli preview)
# ──────────────────────────────────────────────
def run_preview(directory: str = ".", port: int = 3000, background: bool = False):
    """Launch local HTTP server to preview static web files (HTML, CSS, JS)."""
    import threading
    from http.server import HTTPServer, SimpleHTTPRequestHandler

    expanded = os.path.expanduser(directory)
    if not os.path.exists(expanded):
        console.print(f"  [red]✗ Directory not found:[/red] {directory}\n")
        return None

    chosen_port = port
    for p in range(port, port + 25):
        with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
            if s.connect_ex(("127.0.0.1", p)) != 0:
                chosen_port = p
                break

    abs_path = os.path.abspath(expanded)

    class QuietHandler(SimpleHTTPRequestHandler):
        def __init__(self, *args, **kwargs):
            super().__init__(*args, directory=abs_path, **kwargs)
        def log_message(self, format, *args):
            pass

    try:
        httpd = HTTPServer(("0.0.0.0", chosen_port), QuietHandler)
    except Exception as e:
        console.print(f"  [red]✗ Could not start server on port {chosen_port}:[/red] {e}\n")
        return None

    url = f"http://localhost:{chosen_port}"
    if background:
        t = threading.Thread(target=httpd.serve_forever, daemon=True)
        t.start()
        console.print(Panel(
            Text.from_markup(
                f"[bold #ff3344]Local Preview Server Started[/bold #ff3344]\n\n"
                f"[dim]URL      :[/dim] [bold #ff4d4d]{url}[/bold #ff4d4d]\n"
                f"[dim]Directory:[/dim] [white]{abs_path}[/white]\n"
                f"[dim]Mode     :[/dim] Background Daemon"
            ),
            border_style="#cc0029",
            box=box.ROUNDED,
            padding=(0, 2)
        ))
        return url
    else:
        console.print(Panel(
            Text.from_markup(
                f"[bold #ff3344]Local Preview Server[/bold #ff3344]\n\n"
                f"[dim]URL      :[/dim] [bold #ff4d4d]{url}[/bold #ff4d4d]\n"
                f"[dim]Directory:[/dim] [white]{abs_path}[/white]\n\n"
                f"[dim #888888]Press [bold red]Ctrl+C[/bold red] to stop server...[/dim #888888]"
            ),
            border_style="#cc0029",
            box=box.ROUNDED,
            padding=(0, 2)
        ))
        try:
            httpd.serve_forever()
        except KeyboardInterrupt:
            console.print("\n  [dim]Preview server stopped.[/dim]\n")
        return url


# ──────────────────────────────────────────────
# Self Updater (/update, pips-cli update)
# ──────────────────────────────────────────────
def run_self_update() -> bool:
    """Updates pips-cli and pips-agent to the latest version directly."""
    console.print()
    console.print(Panel(
        Text.from_markup(
            "[bold #ff3344]💀 PIPS Self-Updater[/bold #ff3344]\n"
            "[dim #888888]Checking remote repository for latest releases...[/dim #888888]"
        ),
        border_style="#cc0029",
        box=box.ROUNDED,
        padding=(0, 2)
    ))

    script_path = os.path.abspath(__file__)
    script_dir = os.path.dirname(script_path)

    targets = [
        {
            "name": "pips-cli",
            "urls": [
                "https://raw.githubusercontent.com/cadisetrama86/pips-cli/main/bin/pips-cli",
                "https://pips.dvikara.cloud/pips-cli.py",
            ],
            "destinations": [
                script_path,
                os.path.expanduser("~/.pips/cli/pips-cli.py"),
                os.path.expanduser("~/.pips/cli/pips-cli"),
            ]
        },
        {
            "name": "pips-agent",
            "urls": [
                "https://raw.githubusercontent.com/cadisetrama86/pips-cli/main/bin/pips-agent",
                "https://pips.dvikara.cloud/pips-agent.py",
            ],
            "destinations": [
                os.path.join(script_dir, "pips-agent"),
                os.path.join(script_dir, "pips-agent.py"),
                os.path.expanduser("~/.pips/cli/pips-agent.py"),
                os.path.expanduser("~/.pips/cli/pips-agent"),
            ]
        }
    ]

    for target in targets:
        usr_bin = f"/usr/local/bin/{target['name']}"
        if os.path.exists(usr_bin) and os.access(usr_bin, os.W_OK):
            target["destinations"].append(usr_bin)

    all_ok = True
    for item in targets:
        name = item["name"]
        content = None
        with console.status(f"[bold cyan]Fetching latest {name}...[/bold cyan]", spinner="dots"):
            for url in item["urls"]:
                try:
                    req = urllib.request.Request(
                        url,
                        headers={"User-Agent": "pips-cli-updater/2.0", "Cache-Control": "no-cache"}
                    )
                    with urllib.request.urlopen(req, timeout=15) as resp:
                        data = resp.read()
                        if data and len(data) > 1000:
                            content = data
                            break
                except Exception:
                    continue

        if not content:
            console.print(f"  [red]✗[/red] Failed to download latest [bold]{name}[/bold].")
            all_ok = False
            continue

        updated_any = False
        seen_paths = set()
        for dst in item["destinations"]:
            dst_norm = os.path.normpath(dst)
            if dst_norm in seen_paths:
                continue
            seen_paths.add(dst_norm)

            if os.path.exists(dst_norm) or dst_norm == os.path.normpath(script_path):
                try:
                    os.makedirs(os.path.dirname(dst_norm), exist_ok=True)
                    tmp_file = dst_norm + ".tmp"
                    with open(tmp_file, "wb") as f:
                        f.write(content)
                    if sys.platform != "win32":
                        st = os.stat(tmp_file)
                        os.chmod(tmp_file, st.st_mode | 0o755)
                    shutil.move(tmp_file, dst_norm)
                    updated_any = True
                    console.print(f"  [green]✓[/green] Updated [bold]{name}[/bold] -> [dim]{dst_norm}[/dim]")
                except Exception as e:
                    console.print(f"  [yellow]![/yellow] Could not overwrite {dst_norm}: {e}")

        if not updated_any:
            default_dst = os.path.join(script_dir, name if sys.platform != "win32" else f"{name}.py")
            try:
                os.makedirs(os.path.dirname(default_dst), exist_ok=True)
                with open(default_dst, "wb") as f:
                    f.write(content)
                if sys.platform != "win32":
                    os.chmod(default_dst, 0o755)
                console.print(f"  [green]✓[/green] Installed [bold]{name}[/bold] -> [dim]{default_dst}[/dim]")
            except Exception as e:
                console.print(f"  [red]✗[/red] Error installing {name}: {e}")
                all_ok = False

    if all_ok:
        console.print("\n  [bold green]✓ PIPS CLI & Agent updated successfully to the latest version![/bold green]\n")
    return all_ok


# ──────────────────────────────────────────────
# Slash Commands Handler (Rule 8, 9, 12)
# ──────────────────────────────────────────────
def handle_slash(cmd: str, model_id: str, messages: list, is_agent: bool) -> tuple[str, list, bool, bool]:
    """Handles slash commands. Returns (model_id, messages, should_continue, is_agent)."""
    parts = cmd.strip().split(maxsplit=1)
    command = parts[0].lower()
    arg = parts[1].strip() if len(parts) > 1 else ""

    if command in ("/exit", "/quit", "/q"):
        console.print("\n  [dim]Goodbye.[/dim]\n")
        return model_id, messages, False, is_agent

    elif command in ("/model", "/models"):
        if arg == "--refresh":
            model_service.fetch_models(force=True)
            console.print("  [green]✓[/green] Model catalog refreshed.\n")
            return model_id, messages, True, is_agent

        if arg:
            # Query-based search or direct match
            model_service.fetch_models()
            matched = [
                m for m in model_service.models
                if arg.lower() in m["id"].lower() or arg.lower() in m["name"].lower()
            ]
            if len(matched) == 1:
                new_id = matched[0]["id"]
                console.print(f"  [green]✓[/green] Model switched to [bold]{matched[0]['name']}[/bold] ([dim]{new_id}[/dim])\n")
                return new_id, messages, True, is_agent
            elif len(matched) > 1:
                new_id = interactive_select_model(model_id, search_initial=arg)
                name, _ = ModelService.format_model_metadata(new_id)
                print_chat_header(new_id, is_agent)
                console.print(f"  [green]✓[/green] Model switched to [bold]{name}[/bold]\n")
                return new_id, messages, True, is_agent
            else:
                console.print(f"  [yellow]No model found matching:[/yellow] {arg}\n")
                return model_id, messages, True, is_agent

        # Open interactive selector
        new_id = interactive_select_model(model_id)
        name, _ = ModelService.format_model_metadata(new_id)
        print_chat_header(new_id, is_agent)
        console.print(f"  [green]✓[/green] Model switched to [bold]{name}[/bold]\n")
        return new_id, messages, True, is_agent

    elif command == "/agent":
        is_agent = not is_agent
        print_chat_header(model_id, is_agent)
        status = "[bold green]ENABLED[/bold green]" if is_agent else "[dim]DISABLED (Chat mode)[/dim]"
        console.print(f"  [magenta]🤖 Agent Mode:[/magenta] {status}\n")
        return model_id, messages, True, is_agent

    elif command == "/clear":
        messages_only = [m for m in messages if m.get("role") == "system"]
        session_file = os.path.expanduser("~/.pips/agent_session.json")
        if os.path.exists(session_file):
            try:
                os.remove(session_file)
            except Exception:
                pass
        print_chat_header(model_id, is_agent)
        console.print("  [dim]Chat history and agent session memory cleared.[/dim]\n")
        return model_id, messages_only, True, is_agent

    elif command == "/preview":
        target = arg if arg else "."
        run_preview(target, background=True)
        return model_id, messages, True, is_agent

    elif command == "/update":
        run_self_update()
        return model_id, messages, True, is_agent

    elif command == "/history":
        if not messages:
            console.print("  [dim]No history yet.[/dim]\n")
        else:
            console.print()
            for m in messages:
                role = m.get("role")
                if role == "system": continue
                content = m.get("content", "")
                snippet = content[:150] + "..." if len(content) > 150 else content
                if role == "user":
                    console.print(f"  [bold #ff4d4d]🩸 you >[/bold #ff4d4d] {snippet}")
                elif role == "assistant":
                    console.print(f"  [bold #ff3344]💀 pips >[/bold #ff3344] {snippet}")
            console.print()
        return model_id, messages, True, is_agent

    elif command in ("/auto", "/smart"):
        new_id = "auto"
        print_chat_header(new_id, is_agent)
        is_local_avail = auto_router.is_local_online()
        loc_str = "Local Ollama + Cloud Hybrid" if is_local_avail else "Cloud Gateway"
        console.print(f"  [green]✓[/green] Switched to [bold]Auto (Smart Hybrid Router)[/bold] [bold green]⚡ {loc_str} (Token-Saver Active)[/bold green]\n")
        return new_id, messages, True, is_agent

    elif command in ("/hermes", "/local"):
        local_models = auto_router.get_local_models(force=True)
        if local_models:
            new_id = f"ollama/{local_models[0]}"
            name = local_models[0]
            print_chat_header(new_id, is_agent)
            console.print(f"  [green]✓[/green] Switched to [bold]{name}[/bold] ([dim]{new_id}[/dim]) [bold green]⚡ Local Direct (0 Cloud Tokens)[/bold green]\n")
            return new_id, messages, True, is_agent
        else:
            model_service.fetch_models()
            hermes_models = [m for m in model_service.models if "hermes" in m["id"].lower() or m["id"].startswith("ollama/")]
            if hermes_models:
                new_id = hermes_models[0]["id"]
                name = hermes_models[0]["name"]
                print_chat_header(new_id, is_agent)
                console.print(f"  [green]✓[/green] Switched to [bold]{name}[/bold] ([dim]{new_id}[/dim]) [bold green]⚡ Local Token-Saver Active[/bold green]\n")
                return new_id, messages, True, is_agent
            else:
                console.print("  [yellow]No local Ollama models found.[/yellow]\n  [dim]Tip: Ensure Ollama is running and run: ollama pull hermes-gemma:4b[/dim]\n")
                return model_id, messages, True, is_agent

    elif command in ("/tokens", "/stats", "/token"):
        est_in = token_optimizer.prompt_tokens_est
        est_out = token_optimizer.completion_tokens_est
        est_saved = token_optimizer.saved_tokens_est
        local_q = token_optimizer.local_queries_count
        cloud_q = token_optimizer.cloud_queries_count
        eco_status = "[bold green]ENABLED[/bold green]" if token_optimizer.eco_mode else "[yellow]DISABLED[/yellow]"

        lbl, _ = ModelService.format_model_metadata(model_id)
        if model_id.lower() == "auto":
            is_local_avail = auto_router.is_local_online()
            local_name = auto_router.get_local_models()[0] if is_local_avail else "None"
            tier_info = f"[bold green]Auto Hybrid (Local 0-Token: {local_name})[/bold green]" if is_local_avail else "[cyan]Auto Hybrid (Cloud Flash)[/cyan]"
        elif token_optimizer.is_local_model(model_id):
            tier_info = "[bold green]Ollama Local (100% Free • Zero Cloud Tokens)[/bold green]"
        else:
            tier_info = "[cyan]Remote Cloud Gateway[/cyan]"

        console.print(Panel(
            Text.from_markup(
                f"[bold #ff3344]📊 PIPS Smart Token & Savings Dashboard[/bold #ff3344]\n\n"
                f"  [dim]Active Model     :[/dim] [bold white]{lbl}[/bold white] ([dim]{model_id}[/dim])\n"
                f"  [dim]Routing Strategy :[/dim] {tier_info}\n"
                f"  [dim]Eco Token Saver  :[/dim] {eco_status} [dim](Sliding context & deduplication)[/dim]\n"
                f"  [dim]Local Queries    :[/dim] [bold green]{local_q} queries (0 Cloud Tokens)[/bold green]\n"
                f"  [dim]Cloud Queries    :[/dim] [white]{cloud_q} queries[/white]\n"
                f"  [dim]Cloud In / Out   :[/dim] [dim]~{est_in:,} in / ~{est_out:,} out[/dim]\n"
                f"  [dim]Tokens Saved     :[/dim] [bold green]~{est_saved:,} tokens (100% Free)[/bold green]\n\n"
                f"[dim #888888]💡 In 'Auto' mode, simple chats & code snippets run on Local Ollama for 0 cloud tokens.[/dim #888888]"
            ),
            border_style="#cc0029",
            box=box.ROUNDED,
            padding=(0, 2)
        ))
        return model_id, messages, True, is_agent

    elif command == "/eco":
        token_optimizer.eco_mode = not token_optimizer.eco_mode
        status = "[bold green]ENABLED[/bold green]" if token_optimizer.eco_mode else "[yellow]DISABLED[/yellow]"
        console.print(f"  [green]✓[/green] Eco Token-Saver Mode: {status}\n")
        return model_id, messages, True, is_agent

    elif command == "/status":
        console.print()
        try:
            req = urllib.request.Request(f"{ROUTER_BASE_URL.replace('/v1', '')}/api/health", headers={"Authorization": f"Bearer {API_KEY}"})
            with urllib.request.urlopen(req, timeout=4) as r:
                data = json.loads(r.read())
            online = data.get("ok", True)
            status_text = "[bold green]ONLINE[/bold green]" if online else "[yellow]DEGRADED[/yellow]"
        except Exception:
            status_text = "[red]OFFLINE[/red]"

        lbl, _ = ModelService.format_model_metadata(model_id)
        is_local_online = auto_router.is_local_online()
        local_status = f"[bold green]ONLINE[/bold green] ({auto_router.get_local_models()[0]})" if is_local_online else "[dim]OFFLINE[/dim]"
        console.print(Panel(
            Text.from_markup(
                f"[bold #ff3344]9Router AI Gateway[/bold #ff3344]: {status_text}\n"
                f"[dim]Endpoint     :[/dim] [white]{ROUTER_BASE_URL}[/white]\n"
                f"[dim]Local Ollama :[/dim] {local_status} ([dim]{OLLAMA_BASE_URL}[/dim])\n"
                f"[dim]Active Model :[/dim] [bold #ff4d4d]{lbl}[/bold #ff4d4d] ([dim]{model_id}[/dim])\n"
                f"[dim]Cached Models:[/dim] {len(model_service.models)} models available"
            ),
            border_style="#cc0029",
            box=box.ROUNDED,
            padding=(0, 2)
        ))
        console.print()
        return model_id, messages, True, is_agent

    elif command in ("/paste", "/multiline"):
        console.print(Panel(
            Text.from_markup(
                "[bold #ff3344]📝 Multiline / Paste Mode[/bold #ff3344]\n"
                "[dim #888888]Type or paste your multiline prompt. Type [bold white]EOF[/bold white] or press [bold white]Enter[/bold white] on an empty line when done.[/dim #888888]"
            ),
            border_style="#cc0029",
            padding=(0, 2)
        ))
        p_lines = []
        while True:
            try:
                pl = input("  ... > ")
                if pl.strip() == "EOF" or (not pl and p_lines):
                    break
                p_lines.append(pl)
            except (EOFError, KeyboardInterrupt):
                break
        p_text = "\n".join(p_lines).strip()
        if p_text:
            if is_agent:
                run_agent_turn(p_text)
            else:
                messages.append({"role": "user", "content": p_text})
                response = render_response(model_id, messages)
                if response:
                    messages.append({"role": "assistant", "content": response})
        return model_id, messages, True, is_agent

    elif command == "/help":
        console.print(Panel(
            Text.from_markup(
                "[bold #ff3344]PIPS CLI Commands • Crimson Protocol[/bold #ff3344]\n\n"
                "  [bold #ff4d4d]/auto[/bold #ff4d4d]           — switch to Auto Smart Hybrid Router (Local-first & 0-token)\n"
                "  [bold #ff4d4d]/hermes[/bold #ff4d4d]         — quick switch to local Ollama (0 Cloud Cost)\n"
                "  [bold #ff4d4d]/tokens[/bold #ff4d4d]         — view session token statistics & savings\n"
                "  [bold #ff4d4d]/eco[/bold #ff4d4d]            — toggle Eco Token-Saver mode (sliding context)\n"
                "  [bold #ff4d4d]/model[/bold #ff4d4d]          — open interactive model selector\n"
                "  [bold #ff4d4d]/model <name>[/bold #ff4d4d]   — search or switch model by name\n"
                "  [bold #ff4d4d]/models[/bold #ff4d4d]         — open model selector\n"
                "  [bold #ff4d4d]/agent[/bold #ff4d4d]          — toggle Autonomous VPS Agent Mode\n"
                "  [bold #ff4d4d]/paste[/bold #ff4d4d]          — open multiline / paste mode\n"
                "  [bold #ff4d4d]/preview[/bold #ff4d4d] [path]  — launch local web preview server\n"
                "  [bold #ff4d4d]/update[/bold #ff4d4d]         — check and install latest update\n"
                "  [bold #ff4d4d]/clear[/bold #ff4d4d]          — clear chat history & agent memory\n"
                "  [bold #ff4d4d]/history[/bold #ff4d4d]        — view session messages\n"
                "  [bold #ff4d4d]/status[/bold #ff4d4d]         — check 9Router & Ollama connectivity\n"
                "  [bold #ff4d4d]/help[/bold #ff4d4d]           — show this help\n"
                "  [bold #ff4d4d]/exit[/bold #ff4d4d]           — quit application\n\n"
                "[dim #888888]Tip: Press [bold white]Shift+Enter[/bold white], end with [bold white]\\[/bold white], or paste code to write multiline prompts.[/dim #888888]"
            ),
            border_style="#cc0029",
            box=box.ROUNDED,
            padding=(0, 2)
        ))
        return model_id, messages, True, is_agent

    else:
        console.print(f"  [yellow]Unknown command:[/yellow] {command}  (type [bold]/help[/bold])\n")
        return model_id, messages, True, is_agent


# ──────────────────────────────────────────────
# Multiline & Shift+Enter Input Handler
# ──────────────────────────────────────────────
def is_modifier_held() -> bool:
    """Check if Shift, Alt, or Ctrl key is currently held down on Windows."""
    if sys.platform == "win32":
        try:
            import ctypes
            u32 = ctypes.windll.user32
            # 0x10 = VK_SHIFT, 0x12 = VK_MENU (Alt)
            shift_pressed = (u32.GetAsyncKeyState(0x10) & 0x8000) != 0
            alt_pressed = (u32.GetAsyncKeyState(0x12) & 0x8000) != 0
            return shift_pressed or alt_pressed
        except Exception:
            return False
    return False


def has_buffered_input() -> bool:
    """Check if more pasted input is currently queued in stdin."""
    if sys.platform == "win32":
        try:
            import msvcrt
            return msvcrt.kbhit() != 0
        except Exception:
            return False
    else:
        try:
            import select
            r, _, _ = select.select([sys.stdin], [], [], 0.02)
            return bool(r)
        except Exception:
            return False


def has_unclosed_quotes(text: str) -> bool:
    """Check if text has unclosed triple quotes or markdown fence."""
    for q in ('"""', "'''", "```"):
        if text.count(q) % 2 != 0:
            return True
    return False


def read_user_input(prompt_sym: str) -> str:
    """
    Read user input with automatic multiline support:
    - Shift+Enter or Alt+Enter inserts a newline.
    - Trailing backslash (\\) continues to next line.
    - Unclosed triple quotes (``` or \"\"\") continues to next line.
    - Pasting multi-line text automatically captures all lines together.
    """
    lines = []
    continuation_prompt = "   ...   "

    while True:
        curr_prompt = prompt_sym if not lines else continuation_prompt
        try:
            line = input(curr_prompt)
        except EOFError:
            if lines:
                break
            raise

        # Check modifier keys and paste buffer immediately upon Enter
        shift_held = is_modifier_held()
        pasted_more = has_buffered_input()

        # Check for trailing backslash line continuation
        has_backslash = line.rstrip().endswith("\\")
        if has_backslash:
            line = line.rstrip()[:-1]

        lines.append(line)
        current_full = "\n".join(lines)

        should_continue = (
            shift_held or
            has_backslash or
            has_unclosed_quotes(current_full) or
            pasted_more
        )

        if not should_continue:
            break

    return "\n".join(lines)


# ──────────────────────────────────────────────
# Interactive Chat Session
# ──────────────────────────────────────────────
def run_chat_session(initial_model_id: str = None, start_agent: bool = False):
    global current_model_id
    model_id = initial_model_id or current_model_id
    is_agent = start_agent

    print_chat_header(model_id, is_agent)

    messages = [
        {
            "role": "system",
            "content": token_optimizer.get_system_prompt(model_id)
        }
    ]

    while True:
        prompt_sym = "🔥 agent > " if is_agent else "🩸 you > "
        try:
            user_input = read_user_input(prompt_sym)
        except (EOFError, KeyboardInterrupt):
            console.print("\n  [dim]Exiting chat session.[/dim]\n")
            break

        user_input = user_input.strip()
        if not user_input:
            continue

        save_history()

        # Handle slash commands
        if user_input.startswith("/"):
            model_id, messages, cont, is_agent = handle_slash(user_input, model_id, messages, is_agent)
            current_model_id = model_id
            if not cont:
                break
            continue

        if is_agent:
            run_agent_turn(user_input)
            continue

        messages.append({"role": "user", "content": user_input})
        response = render_response(model_id, messages)

        if response:
            messages.append({"role": "assistant", "content": response})

    save_history()


# ──────────────────────────────────────────────
# Main CLI Entry Point
# ──────────────────────────────────────────────
def main():
    global current_model_id

    # Warm-up / cache models from 9Router in background or startup
    model_service.fetch_models()
    if model_service.models:
        current_model_id = model_service.models[0]["id"]
        # Prioritize 'auto' smart router combo if available
        for m in model_service.models:
            if m["id"].lower() == "auto":
                current_model_id = m["id"]
                break
        else:
            for m in model_service.models:
                if m["id"] == "ag/gemini-3.8-flash":
                    current_model_id = m["id"]
                    break

    args = sys.argv[1:]

    # One-shot command line handling
    if args:
        first = args[0]
        if first in ("-h", "--help"):
            print("Usage: pips-cli [OPTIONS] [PROMPT]")
            print("\nPIPS CLI — AI Development Companion powered by 9Router.")
            print("\nOptions:")
            print("  chat                      Open interactive chat directly")
            print("  hermes, --hermes, local   Start chat immediately using Local Hermes (Token-Saver)")
            print("  agent, --agent            Launch directly in Autonomous VPS Agent mode")
            print("  models, --models          Open interactive model selector")
            print("  preview [dir]             Launch local HTTP web preview server")
            print("  update                    Update PIPS CLI & Agent to latest version")
            print("  -h, --help                Show this help message and exit")
            print("\nExamples:")
            print("  pips-cli                  Open main menu")
            print("  pips-cli chat             Start chat immediately")
            print("  pips-cli hermes           Chat directly with local Hermes (0 cloud tokens)")
            print("  pips-cli agent            Run autonomous agent")
            print("  pips-cli preview          Preview current folder at http://localhost:3000")
            print("  pips-cli update           Self-update to latest release")
            print("  pips-cli 'what is docker' Run single query and print result")
            sys.exit(0)
        elif first in ("update", "--update", "upgrade"):
            run_self_update()
            sys.exit(0)
        elif first in ("preview", "--preview"):
            target_dir = args[1] if len(args) > 1 else "."
            run_preview(target_dir, background=False)
            sys.exit(0)
        elif first in ("chat", "--chat"):
            run_chat_session(current_model_id)
            sys.exit(0)
        elif first in ("hermes", "--hermes", "local", "--local", "-l"):
            hermes_models = [m for m in model_service.models if "hermes" in m["id"].lower()]
            if not hermes_models:
                hermes_models = [m for m in model_service.models if m["id"].startswith("ollama/")]
            chosen_local = hermes_models[0]["id"] if hermes_models else current_model_id

            prompt = " ".join(args[1:]) if len(args) > 1 else None
            if prompt:
                msgs = [
                    {"role": "system", "content": token_optimizer.get_system_prompt(chosen_local)},
                    {"role": "user", "content": prompt}
                ]
                render_response(chosen_local, msgs)
            else:
                run_chat_session(chosen_local)
            sys.exit(0)
        elif first in ("agent", "--agent", "-a"):
            prompt = " ".join(args[1:]) if len(args) > 1 else None
            if prompt:
                run_agent_turn(prompt)
            else:
                run_chat_session(current_model_id, start_agent=True)
            sys.exit(0)
        elif first in ("models", "--models", "--select"):
            chosen = interactive_select_model(current_model_id)
            current_model_id = chosen
            name, _ = ModelService.format_model_metadata(chosen)
            console.print(f"\n  [green]✓[/green] Active model set to: [bold]{name}[/bold] ([dim]{chosen}[/dim])\n")
            sys.exit(0)
        else:
            # One-shot query mode
            one_shot_prompt = " ".join(args)
            msgs = [
                {"role": "system", "content": token_optimizer.get_system_prompt(current_model_id)},
                {"role": "user", "content": one_shot_prompt}
            ]
            render_response(current_model_id, msgs)
            sys.exit(0)

    # If stdin is not a TTY (pipe mode), directly open chat
    if not sys.stdin.isatty():
        run_chat_session(current_model_id)
        sys.exit(0)

    # Interactive Main Menu Loop (Rule 6)
    while True:
        action = show_main_screen()

        if action == "chat":
            run_chat_session(current_model_id)
        elif action == "models":
            chosen = interactive_select_model(current_model_id)
            current_model_id = chosen
            name, _ = ModelService.format_model_metadata(chosen)
            console.print(f"\n  [green]✓[/green] Selected: [bold]{name}[/bold]")
            time.sleep(0.8)
        elif action == "agents":
            run_chat_session(current_model_id, start_agent=True)
        elif action == "preview":
            run_preview(".", background=False)
            console.print("\n[dim]Press Enter to return to main menu...[/dim]")
            read_single_key()
        elif action == "update":
            run_self_update()
            console.print("\n[dim]Press Enter to return to main menu...[/dim]")
            read_single_key()
        elif action == "history":
            console.clear()
            console.print(Panel("[bold #ff3344]Recent Input History • Crimson Core[/bold #ff3344]", border_style="#cc0029"))
            if os.path.exists(HISTORY_FILE):
                with open(HISTORY_FILE, "r", encoding="utf-8", errors="replace") as f:
                    hist_lines = [l.strip() for l in f.readlines() if l.strip()][-15:]
                for h in hist_lines:
                    console.print(f"  [dim #ff4d4d]•[/dim #ff4d4d] [white]{h}[/white]")
            else:
                console.print("  [dim #888888]No history file yet.[/dim #888888]")
            console.print("\n[dim #777777]Press Enter to return to main menu...[/dim #777777]")
            read_single_key()
        elif action == "settings":
            console.clear()
            console.print(Panel(
                Text.from_markup(
                    f"[bold #ff3344]PIPS CLI Configuration • Crimson Core[/bold #ff3344]\n\n"
                    f"[dim #888888]9Router Gateway :[/dim #888888] [white]{ROUTER_BASE_URL}[/white]\n"
                    f"[dim #888888]Agent Service   :[/dim #888888] [white]{PIPS_AGENT_URL}[/white]\n"
                    f"[dim #888888]Active Model    :[/dim #888888] [bold #ff4d4d]{current_model_id}[/bold #ff4d4d]\n"
                    f"[dim #888888]API Key         :[/dim #888888] [dim]{API_KEY[:8]}...{API_KEY[-4:] if len(API_KEY)>12 else ''}[/dim]\n"
                    f"[dim #888888]Working Dir     :[/dim #888888] [white]{os.getcwd()}[/white]"
                ),
                border_style="#cc0029",
                box=box.ROUNDED,
                padding=(1, 2)
            ))
            console.print("[dim #777777]Press Enter to return to main menu...[/dim #777777]")
            read_single_key()
        elif action == "exit":
            console.print("\n[dim]Goodbye![/dim]\n")
            break


if __name__ == "__main__":
    main()
