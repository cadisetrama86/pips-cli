# ──────────────────────────────────────────────
# Header & ASCII Art
# ──────────────────────────────────────────────
PIPS_ASCII = """\
 ██████╗ ██╗██████╗ ███████╗
 ██╔══██╗██║██╔══██╗██╔════╝
 ██████╔╝██║██████╔╝███████╗
