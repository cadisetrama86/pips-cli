 ██║     ██║██║     ███████║
 ╚═╝     ╚═╝╚═╝     ╚══════╝"""


def print_header(model_id: str):
    model_name = model_id
    model_desc = ""
    for k, (mid, mname, mdesc) in MODELS.items():
        if mid == model_id:
            model_name = mname
            model_desc = mdesc
            break

    ascii_lines = PIPS_ASCII.strip("\n").splitlines()
    ascii_text = "\n".join(f"[bold cyan]{line}[/bold cyan]" for line in ascii_lines)

    console.print()
    console.print(Panel(
        Text.from_markup(
            f"{ascii_text}\n\n"
            f"[dim]Personal AI Infrastructure & Pipeline Server[/dim]\n\n"
            f"[dim]Model  :[/dim] [bold green]{model_name}[/bold green]  [dim]{model_desc}[/dim]\n"
            f"[dim]Model ID:[/dim] [blue]{model_id}[/blue]\n\n"
            f"[dim]Type [/dim][bold]/help[/bold][dim] for commands  •  [/dim][bold]/model[/bold][dim] to switch model  •  [/dim][bold]/exit[/bold][dim] to quit[/dim]"
        ),
        border_style="cyan",
        padding=(1, 2),
    ))
    console.print()


# ──────────────────────────────────────────────
# Model selector
# ──────────────────────────────────────────────
def select_model() -> str:
    console.print(Panel(
        "[bold cyan]Select Model[/bold cyan]",
        border_style="cyan",
        padding=(0, 1),
    ))
    console.print()

    for k, (mid, mname, mdesc) in MODELS.items():
        active = "●" if mid == DEFAULT_MODEL_ID else " "
        console.print(f"  [cyan]{k}[/cyan]  [green]{active}[/green]  [white]{mname}[/white]  [dim]{mdesc}[/dim]")

    console.print()
    console.print(f"  [dim]Press Enter for default ([/dim][green]{DEFAULT_MODEL_ID}[/green][dim])[/dim]")
    console.print()

    try:
        choice = input("  Select [1-9]: ").strip()
    except (EOFError, KeyboardInterrupt):
        return DEFAULT_MODEL_ID

    if choice in MODELS:
        selected_id = MODELS[choice][0]
        console.print(f"\n  [green]✓[/green] Selected: [bold]{MODELS[choice][1]}[/bold]\n")
        return selected_id

    return DEFAULT_MODEL_ID


# ──────────────────────────────────────────────
# Stream chat (menggunakan urllib — no extra deps)
# ──────────────────────────────────────────────
def stream_chat(messages: list, model_id: str) -> str:
    """Stream response from 9Router, returns full text."""
    url = f"{PIPS_BASE_URL}/chat/completions"
    headers = {
        "Content-Type":  "application/json",
        "Authorization": f"Bearer {API_KEY}",
        "Accept":        "text/event-stream",
        "User-Agent":    "pips-cli/1.0",
    }
    payload = json.dumps({
        "model":    model_id,
        "messages": messages,
        "stream":   True,
    }).encode("utf-8")

    req = urllib.request.Request(url, data=payload, headers=headers, method="POST")

    full_text = ""
    try:
        with urllib.request.urlopen(req, timeout=120) as resp:
            for raw_line in resp:
                line = raw_line.decode("utf-8", errors="replace").strip()
                if not line or line == "data: [DONE]":
                    continue
                if line.startswith("data: "):
                    json_str = line[6:]
                    try:
                        chunk = json.loads(json_str)
                        delta = chunk.get("choices", [{}])[0].get("delta", {})
                        content = delta.get("content", "")
                        if content:
                            full_text += content
                            yield content
                    except json.JSONDecodeError:
                        pass
    except urllib.error.HTTPError as e:
        body = e.read().decode("utf-8", errors="replace")
        raise RuntimeError(f"HTTP {e.code}: {body}")
    except urllib.error.URLError as e:
        raise RuntimeError(f"Connection error: {e.reason}")


# ──────────────────────────────────────────────
# Thinking indicator
# ──────────────────────────────────────────────
class ThinkingIndicator:
    def __init__(self):
        self._live = None
        self._stop = False

    def __enter__(self):
        self._stop = False
        spinner = Spinner("dots", text=Text.from_markup(" [dim]Thinking...[/dim]"))
        self._live = Live(spinner, console=console, refresh_per_second=10, transient=True)
        self._live.start()
        return self

    def __exit__(self, *_):
        if self._live:
            self._live.stop()


# ──────────────────────────────────────────────
# Render response with streaming + markdown
# ──────────────────────────────────────────────
def render_response(model_id: str, messages: list) -> str:
    """Show thinking spinner, then stream & render response."""

    # Show label
    model_label = model_id
    for k, (mid, mname, _) in MODELS.items():
        if mid == model_id:
            model_label = mname
            break

    console.print()
    console.print(f"  [bold cyan]●[/bold cyan] [dim]{model_label}[/dim]")

    # Thinking phase: spin until first token arrives
    first_chunk_event = threading.Event()
    full_text = []
    error_holder = []
    stream_gen = [None]

    def start_stream():
        try:
            gen = stream_chat(messages, model_id)
            stream_gen[0] = gen
        except Exception as e:
            error_holder.append(e)
            first_chunk_event.set()

    # Pre-create generator
    try:
        gen = stream_chat(messages, model_id)
    except Exception as e:
        console.print(f"\n  [red]✗ Error:[/red] {e}\n")
        return ""

    # Show spinner while waiting for first chunk
    collected = []
    first = True
    with ThinkingIndicator():
        try:
            first_chunk = next(gen)
            collected.append(first_chunk)
        except StopIteration:
            pass
        except RuntimeError as e:
            console.print(f"\n  [red]✗ Error:[/red] {e}\n")
            return ""

    # Now stream the rest with live rendering
    console.print()
    accumulated = "".join(collected)

    try:
        for chunk in gen:
            accumulated += chunk
            # Print chunk directly (inline streaming feel)
            console.print(chunk, end="", markup=False, highlight=False)

        # Final render as markdown
        console.print()  # newline after streaming
        console.print()

        # Re-render as formatted markdown block
        if accumulated.strip():
            console.print(Panel(
                Markdown(accumulated),
                border_style="dim",
                padding=(0, 1),
                box=box.ROUNDED,
            ))

    except RuntimeError as e:
        console.print(f"\n  [red]✗ Error:[/red] {e}\n")
        return ""

    console.print()
    return accumulated


# ──────────────────────────────────────────────
# Slash commands
# ──────────────────────────────────────────────
def handle_slash(cmd: str, model_id: str, messages: list) -> tuple[str, list, bool]:
    """Returns (new_model_id, new_messages, should_continue)"""
    parts = cmd.strip().split(maxsplit=1)
    command = parts[0].lower()

    if command in ("/exit", "/quit", "/q"):
        console.print("\n  [dim]Goodbye.[/dim]\n")
        return model_id, messages, False

    elif command == "/help":
        console.print(Panel(
            Text.from_markup(
                "[bold]Available Commands[/bold]\n\n"
                "  [cyan]/model[/cyan]         — switch AI model\n"
                "  [cyan]/clear[/cyan]         — clear chat history\n"
                "  [cyan]/history[/cyan]       — show chat history\n"
                "  [cyan]/models[/cyan]        — list available models\n"
                "  [cyan]/status[/cyan]        — check 9Router status\n"
                "  [cyan]/help[/cyan]          — show this help\n"
                "  [cyan]/exit[/cyan]          — exit pips-cli\n\n"
                "[dim]Tip: Use ↑↓ arrow keys to navigate history[/dim]"
            ),
            border_style="cyan",
            padding=(0, 2),
        ))
        return model_id, messages, True

    elif command == "/model":
        console.print()
        new_model = select_model()
        console.print(f"  [green]✓[/green] Model switched to [bold]{new_model}[/bold]\n")
        return new_model, messages, True

    elif command == "/models":
        console.print()
        console.print("  [bold]Available Models:[/bold]\n")
        for k, (mid, mname, mdesc) in MODELS.items():
            active = "[green]●[/green]" if mid == model_id else " "
            console.print(f"  {active} [cyan]{k}[/cyan]  [white]{mname}[/white]  [dim]{mdesc}[/dim]")
            console.print(f"     [dim]{mid}[/dim]")
        console.print()
        return model_id, messages, True

    elif command == "/clear":
        messages_only = [m for m in messages if m["role"] == "system"]
        console.clear()
        print_header(model_id)
        console.print("  [dim]Chat history cleared.[/dim]\n")
        return model_id, messages_only, True

    elif command == "/history":
        if not messages:
            console.print("  [dim]No history yet.[/dim]\n")
        else:
            console.print()
            for m in messages:
                role = m["role"]
                content = m["content"][:200] + "..." if len(m["content"]) > 200 else m["content"]
                if role == "user":
                    console.print(f"  [bold cyan]You:[/bold cyan] {content}")
                elif role == "assistant":
                    console.print(f"  [bold green]AI:[/bold green]  {content}")
            console.print()
        return model_id, messages, True

    elif command == "/status":
        console.print()
        try:
            req = urllib.request.Request(
                f"{PIPS_BASE_URL.replace('/v1', '')}/api/health",
                headers={"Authorization": f"Bearer {API_KEY}"},
            )
            with urllib.request.urlopen(req, timeout=5) as r:
                data = json.loads(r.read())
            if data.get("ok"):
                console.print(f"  [green]✓[/green] 9Router: [bold green]ONLINE[/bold green]")
            else:
                console.print(f"  [yellow]⚠[/yellow] 9Router: [yellow]DEGRADED[/yellow]")
        except Exception as e:
            console.print(f"  [red]✗[/red] 9Router: [red]OFFLINE[/red] — {e}")
        model_name = next((v[1] for v in MODELS.values() if v[0] == model_id), model_id)
        console.print(f"  [dim]Endpoint: {PIPS_BASE_URL}[/dim]")
        console.print(f"  [dim]Model:    {model_name} ({model_id})[/dim]\n")
        return model_id, messages, True

    else:
        console.print(f"  [yellow]Unknown command:[/yellow] {command}  (type [bold]/help[/bold])\n")
        return model_id, messages, True


# ──────────────────────────────────────────────
# Input prompt styled like kiro-cli
# ──────────────────────────────────────────────
def get_input() -> str:
    console.print(Rule(style="dim"))
    try:
        # Use readline-enabled input for arrow key history
        text = input("  ❯ ")
    except (EOFError, KeyboardInterrupt):
        return "/exit"
    return text.strip()


# ──────────────────────────────────────────────
# Main loop
# ──────────────────────────────────────────────
def main():
    # Load env from pips.env if not already set
    pips_env = os.path.expanduser("~/.pips/pips.env")
    if os.path.exists(pips_env):
        with open(pips_env) as f:
            for line in f:
                line = line.strip()
                if line and not line.startswith("#") and "=" in line:
                    k, _, v = line.partition("=")
                    os.environ.setdefault(k.strip(), v.strip())

    # Re-read after env loaded
    global API_KEY, PIPS_BASE_URL
    PIPS_BASE_URL = os.environ.get("PIPS_BASE_URL", PIPS_BASE_URL)
    API_KEY = os.environ.get("PIPS_API_KEY", os.environ.get("OPENAI_API_KEY", API_KEY))

    # Model selection at startup
    console.clear()

    # Quick start or model selection
    import sys
    if len(sys.argv) > 1 and sys.argv[1] in [m[0] for m in MODELS.values()]:
        model_id = sys.argv[1]
    elif len(sys.argv) > 1 and sys.argv[1] == "--select":
        model_id = select_model()
    else:
        model_id = DEFAULT_MODEL_ID

    print_header(model_id)

    # System prompt
    messages = [
        {
            "role": "system",
            "content": (
                "You are PIPS AI, a helpful assistant powered by the PIPS personal AI infrastructure. "
                "Be concise, precise, and helpful. When writing code, use proper formatting."
            )
        }
    ]

    # ── Main chat loop ──
    while True:
        try:
            user_input = get_input()
        except KeyboardInterrupt:
            console.print("\n  [dim]Use /exit to quit.[/dim]\n")
            continue

        if not user_input:
            continue

        save_history()

        # Slash command
        if user_input.startswith("/"):
            model_id, messages, cont = handle_slash(user_input, model_id, messages)
            if not cont:
                break
            continue

        # Display user message
        console.print()
        console.print(f"  [bold white]You[/bold white]")
        console.print(f"  {user_input}")

        # Add to history
        messages.append({"role": "user", "content": user_input})

        # Get AI response
        response = render_response(model_id, messages)

        if response:
            messages.append({"role": "assistant", "content": response})

    save_history()
    console.print()


if __name__ == "__main__":
    main()
