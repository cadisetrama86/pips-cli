# ──────────────────────────────────────────────
# Cross-Platform Keyboard Input (Raw Keypress)
# ──────────────────────────────────────────────
def read_single_key() -> str:
    """Reads a single keypress from terminal (Windows & Unix)."""
    if not sys.stdin.isatty():
        line = sys.stdin.readline()
        return "ENTER" if line else "ESC"

    if sys.platform == "win32":
        import msvcrt
        ch = msvcrt.getwch()
        if ch in ('\x00', '\xe0'):
            ch2 = msvcrt.getwch()
            if ch2 == 'H': return 'UP'
            elif ch2 == 'P': return 'DOWN'
            elif ch2 == 'K': return 'LEFT'
            elif ch2 == 'M': return 'RIGHT'
            return ''
        elif ch in ('\r', '\n'): return 'ENTER'
        elif ch == '\x1b': return 'ESC'
        elif ch == '\x08': return 'BACKSPACE'
        elif ch == '\x03': raise KeyboardInterrupt
        return ch
    else:
        import termios, tty, select
        fd = sys.stdin.fileno()
        old_settings = termios.tcgetattr(fd)
        try:
            tty.setcbreak(fd)
            ch = sys.stdin.read(1)
            if ch == '\x1b':
                # Check if this is an arrow key sequence
                r, _, _ = select.select([sys.stdin], [], [], 0.05)
                if r:
                    ch2 = sys.stdin.read(1)
                    if ch2 == '[':
                        ch3 = sys.stdin.read(1)
                        if ch3 == 'A': return 'UP'
                        elif ch3 == 'B': return 'DOWN'
                        elif ch3 == 'C': return 'RIGHT'
                        elif ch3 == 'D': return 'LEFT'
                return 'ESC'
            elif ch in ('\r', '\n'): return 'ENTER'
            elif ch in ('\x7f', '\x08'): return 'BACKSPACE'
            elif ch == '\x03': raise KeyboardInterrupt
            return ch
        finally:
            termios.tcsetattr(fd, termios.TCSADRAIN, old_settings)


# ──────────────────────────────────────────────
# Dynamic Model Discovery Service
# ──────────────────────────────────────────────
class ModelService:
    def __init__(self, base_url: str, api_key: str):
        self.base_url = base_url
        self.api_key = api_key
        self.models: list[dict] = []
        self.last_fetch: float = 0
        self.cache_ttl: float = 300  # 5 minutes in-memory cache

    @staticmethod
    def format_model_metadata(model_id: str) -> tuple[str, str]:
        """Convert model ID to display label & provider group without dropping any unknown model."""
        if model_id.lower() == "auto":
            return "Auto (Smart Router)", "9Router Dynamic"

        parts = model_id.split('/', 1)
        prefix = parts[0] if len(parts) > 1 else ''
        raw_name = parts[1] if len(parts) > 1 else parts[0]

        # Determine clean group name
        prefix_lower = prefix.lower()
        if prefix_lower == 'ollama':
            group = "Ollama Local"
        elif 'claude' in raw_name.lower():
            group = "Anthropic / Claude"
        elif 'gemini' in raw_name.lower():
            group = "Google / Gemini"
        elif any(k in raw_name.lower() for k in ('gpt', 'codex', 'o1', 'o3')):
            group = "OpenAI / Codex"
        elif 'deepseek' in raw_name.lower() or prefix_lower == 'ds':
            group = "DeepSeek"
        elif 'glm' in raw_name.lower():
            group = "Zhipu / GLM"
        elif prefix_lower == 'ag':
            group = "Antigravity Gateway"
        elif prefix_lower == 'cc':
            group = "Claude Gateway"
        elif prefix_lower == 'cx':
            group = "Codex Gateway"
        else:
            group = prefix.upper() if prefix else "Available Models"

        # Generate human-readable label
        words = raw_name.replace('-', ' ').replace('_', ' ').split()
        formatted_words = []
        for w in words:
            wl = w.lower()
            if wl in ('gpt', 'glm', 'ai', 'oss', 'api', 'pro', 'r1', 'v3'):
                formatted_words.append(w.upper())
            elif '.' in w or (w.replace('.', '').isdigit()):
                formatted_words.append(w)
            else:
                formatted_words.append(w.capitalize())

        label = ' '.join(formatted_words)
        return label, group

    def fetch_models(self, force: bool = False) -> tuple[bool, str]:
        """Fetch models dynamically from 9Router GET {ROUTER_BASE_URL}/models."""
        now = time.time()
        if self.models and not force and (now - self.last_fetch < self.cache_ttl):
            return True, "cached"

        url = f"{self.base_url}/models"
        headers = {
            "Authorization": f"Bearer {self.api_key}",
            "User-Agent": "pips-cli/2.0",
            "Accept": "application/json"
        }
        req = urllib.request.Request(url, headers=headers, method="GET")

        try:
            with urllib.request.urlopen(req, timeout=8) as resp:
                data = json.loads(resp.read().decode("utf-8"))
                raw_list = data.get("data", [])
                parsed = []
                for item in raw_list:
                    m_id = item.get("id")
                    if m_id:
                        lbl, grp = self.format_model_metadata(m_id)
                        parsed.append({
                            "id": m_id,
                            "name": lbl,
                            "group": grp,
                            "raw": item
                        })

                if parsed:
                    # Pin 'auto' smart combo to the very top (index 0) if present
                    auto_list = [m for m in parsed if m["id"].lower() == "auto"]
                    other_list = [m for m in parsed if m["id"].lower() != "auto"]
                    self.models = auto_list + other_list
                    self.last_fetch = now
                    return True, f"Loaded {len(parsed)} models"
                else:
                    return False, "9Router returned an empty model list"
        except urllib.error.HTTPError as e:
            return False, f"HTTP {e.code}: {e.reason}"
        except urllib.error.URLError as e:
            return False, f"Unable to reach 9Router at {self.base_url}"
        except Exception as e:
            return False, str(e)


# Initialize global model service
model_service = ModelService(ROUTER_BASE_URL, API_KEY)
current_model_id = DEFAULT_FALLBACK_MODEL


# ──────────────────────────────────────────────
# Token Management & Smart Hybrid Router (Local-First 0-Token & Cloud Fallback)
# ──────────────────────────────────────────────
class SmartAutoRouter:
    def __init__(self, ollama_url: str = OLLAMA_BASE_URL):
        self.ollama_url = ollama_url
        self._cached_local_models: list[str] = []
        self._last_local_check: float = 0
        self._check_interval: float = 15.0

    def get_local_models(self, force: bool = False) -> list[str]:
        now = time.time()
        if self._cached_local_models and not force and (now - self._last_local_check < self._check_interval):
            return self._cached_local_models

        discovered = []

        # 1. Try Direct Ollama endpoint with 2.5s timeout
        for host in (self.ollama_url, "http://127.0.0.1:11434", "http://localhost:11434"):
            url = f"{host}/api/tags"
            req = urllib.request.Request(url, headers={"User-Agent": "pips-cli/2.0"}, method="GET")
            try:
                with urllib.request.urlopen(req, timeout=2.5) as resp:
                    data = json.loads(resp.read().decode("utf-8"))
                    models = [m.get("name") or m.get("model") for m in data.get("models", []) if m.get("name") or m.get("model")]
                    if models:
                        discovered = models
                        break
            except Exception:
                pass

        # 2. Fallback: check 9Router cached model list if direct tags failed
        if not discovered and model_service.models:
            for m in model_service.models:
                m_id = m.get("id", "")
                if m_id.startswith("ollama/"):
                    discovered.append(m_id.split('/', 1)[1])
                elif "hermes" in m_id.lower() and "/" not in m_id:
                    discovered.append(m_id)

        if discovered:
            sorted_models = []
            for prio in ("hermes-gemma:4b", "hermes-gemma", "hermes3:3b", "hermes3", "qwen", "llama", "gemma", "mistral"):
                for m in discovered:
                    if prio in m.lower() and m not in sorted_models:
                        sorted_models.append(m)
            for m in discovered:
                if m not in sorted_models:
                    sorted_models.append(m)
            self._cached_local_models = sorted_models
            self._last_local_check = now
            return self._cached_local_models
        else:
            # Do not lock cache on failure so next prompt can retry immediately
            self._last_local_check = 0
            return []

    def is_local_online(self) -> bool:
        return bool(self.get_local_models())

    def resolve_route(self, messages: list, active_model_id: str) -> tuple[str, bool, str]:
        """
        Resolves (effective_model_id, is_local_direct, route_display_badge).
        - If active_model_id is 'auto': decides whether to route locally (0 tokens) or cloud flash.
        - If active_model_id is 'ollama/...': routes directly to local Ollama.
        - Else: routes to 9Router cloud.
        """
        mid_lower = (active_model_id or "").lower()

        if mid_lower.startswith("ollama/"):
            raw_local = active_model_id.split('/', 1)[1]
            return raw_local, True, "Ollama Local (Direct)"

        if "hermes" in mid_lower and "/" not in active_model_id:
            return active_model_id, True, "Ollama Local (Direct)"

        if mid_lower == "auto":
            local_models = self.get_local_models()
            if local_models:
                best_local = local_models[0]
                return best_local, True, "Auto ⚡ Local Ollama (Free • 0 Cloud Tokens)"
            else:
                # Cloud free / flash fallback
                return "ag/gemini-3.8-flash", False, "Auto ⚡ Cloud Flash"

        # Explicit Cloud model
        lbl, _ = ModelService.format_model_metadata(active_model_id)
        return active_model_id, False, f"Cloud Gateway ({lbl})"


class TokenOptimizer:
    def __init__(self):
        self.prompt_tokens_est: int = 0
        self.completion_tokens_est: int = 0
        self.saved_tokens_est: int = 0
        self.local_queries_count: int = 0
        self.cloud_queries_count: int = 0
        self.eco_mode: bool = True

    @staticmethod
    def estimate_tokens(text: str) -> int:
        """Heuristic calculation: ~4 chars per token."""
        if not text:
            return 0
        return max(1, len(text) // 4)

    @staticmethod
    def is_local_model(model_id: str) -> bool:
        mid = (model_id or "").lower()
        return mid.startswith("ollama/") or "hermes" in mid or "local" in mid or mid == "auto"

    @staticmethod
    def get_system_prompt(model_id: str, is_local: bool = False) -> str:
        cwd = os.getcwd()
        os_name = "Windows" if sys.platform == "win32" else ("macOS" if sys.platform == "darwin" else "Linux")
        user_name = os.environ.get("USERNAME") or os.environ.get("USER") or "user"

        if is_local or TokenOptimizer.is_local_model(model_id):
            # Hermes / Local Compact High-Density System Prompt (saves ~200+ tokens per turn)
            return (
                f"You are PIPS AI (Local Accelerator Mode).\n"
                f"CWD: {cwd} ({os_name}, user: {user_name}).\n"
                f"Rules: Provide direct, accurate answers and exact commands/code with zero unnecessary fluff. If tools or autonomous file changes are needed, suggest /agent."
            )
        else:
            return (
                f"You are PIPS AI, a helpful AI coding and system assistant powered by 9Router.\n"
                f"Active environment:\n"
                f"- Working Directory (CWD): {cwd}\n"
                f"- Operating System: {os_name} ({sys.platform})\n"
                f"- Current User: {user_name}\n\n"
                f"Operational Rules:\n"
                f"- You are in interactive terminal chat mode. You do NOT have tool execution in this mode. NEVER produce function calls.\n"
                f"- When asked to check files, list folders, or run commands, provide exact {os_name} terminal commands with clear explanations.\n"
                f"- Remind the user they can type /agent if they want PIPS to automatically inspect files and execute commands.\n"
                f"- When referring to 'path ini', 'folder ini', 'disini', or relative paths, mean: {cwd}.\n"
                f"- Be concise, direct, and practical."
            )

    def optimize_messages(self, messages: list, model_id: str, is_local: bool = False) -> list:
        """Prunes historical reasoning, removes token bloat, and applies adaptive sliding window."""
        if not messages:
            return []

        local_mode = is_local or self.is_local_model(model_id)
        max_history_turns = 10 if (local_mode or self.eco_mode) else 24

        # Extract non-system messages
        chat_msgs = [m for m in messages if m.get("role") != "system"]

        # Ensure active system prompt matches current model & route
        sys_content = self.get_system_prompt(model_id, local_mode)
        system_msgs = [{"role": "system", "content": sys_content}]

        # Slide context window
        if len(chat_msgs) > max_history_turns:
            dropped_turns = chat_msgs[:-max_history_turns]
            for d in dropped_turns:
                self.saved_tokens_est += self.estimate_tokens(d.get("content", ""))
            chat_msgs = chat_msgs[-max_history_turns:]

        # Clean and compress message content
        compacted_chat = []
        for idx, m in enumerate(chat_msgs):
            role = m.get("role")
            content = m.get("content", "")
            orig_len = len(content)

            # Strip reasoning notices or internal monologue from older assistant turns
            if role == "assistant" and idx < len(chat_msgs) - 1:
                if "*(Catatan:" in content:
                    content = content.split("*(Catatan:")[0].strip()
                # For local/eco mode, truncate older long code dumps to preserve context
                if (local_mode or self.eco_mode) and len(content) > 1500:
                    content = content[:1200] + "\n... [truncated older response to save tokens]"

            # Remove excessive consecutive newlines
            while "\n\n\n" in content:
                content = content.replace("\n\n\n", "\n\n")

            saved_chars = orig_len - len(content)
            if saved_chars > 0:
                self.saved_tokens_est += max(1, saved_chars // 4)

            compacted_chat.append({"role": role, "content": content})

        final_msgs = system_msgs + compacted_chat
        return final_msgs


token_optimizer = TokenOptimizer()
auto_router = SmartAutoRouter()



# ──────────────────────────────────────────────
# Error Display (Rule 11)
# ──────────────────────────────────────────────
def show_router_error(detail: str = ""):
    console.print()
    console.print(Panel(
        Text.from_markup(
            f"[bold yellow]⚠ Unable to connect to 9Router[/bold yellow]\n\n"
            f"[dim]{ROUTER_BASE_URL}[/dim]\n\n"
            f"{detail}\n\n"
            f"[white]Check that 9Router is running and try again.[/white]"
        ),
        border_style="yellow",
        box=box.ROUNDED,
        padding=(1, 2)
    ))
    console.print()


# ──────────────────────────────────────────────
# Interactive Model Selector (Rule 3, 4, 5)
# ──────────────────────────────────────────────
def interactive_select_model(active_id: str, search_initial: str = "") -> str:
    """Pure terminal keyboard-first interactive model selector with live search."""
    ok, err = model_service.fetch_models()
    if not ok and not model_service.models:
        show_router_error(err)
        return active_id

    models = model_service.models
    query = search_initial
    selected_idx = 0

    # Locate current index
    for i, m in enumerate(models):
        if m["id"] == active_id:
            selected_idx = i
            break

    page_size = 7

    while True:
        # Filter models by search query
        if query:
            q_lower = query.lower()
            filtered = [
                m for m in models
                if q_lower in m["id"].lower() or q_lower in m["name"].lower() or q_lower in m["group"].lower()
            ]
        else:
            filtered = models

        if not filtered:
            selected_idx = 0
        elif selected_idx >= len(filtered):
            selected_idx = len(filtered) - 1
        elif selected_idx < 0:
            selected_idx = 0

        # Calculate window for scroll
        start_idx = max(0, min(selected_idx - page_size // 2, len(filtered) - page_size))
        end_idx = min(start_idx + page_size, len(filtered))
        visible_items = filtered[start_idx:end_idx]

        # Render Selector Panel
        lines = []
        if query:
            lines.append(f"  [bold #ff3344]Search:[/bold #ff3344] [white]{query}[/white][blink]_[/blink]\n")
        else:
            lines.append(f"  [dim #888888]Type to search • Press / to filter[/dim #888888]\n")

        if not filtered:
            lines.append("  [dim italic #888888]No matching models found[/dim italic #888888]\n")
        else:
            for idx_offset, m in enumerate(visible_items):
                actual_idx = start_idx + idx_offset
                is_selected = (actual_idx == selected_idx)
                is_active = (m["id"] == active_id)

                indicator = "[bold #ff3344]◈[/bold #ff3344]" if is_selected else " "
                active_mark = "[bold #ff4d4d]● [/bold #ff4d4d]" if is_active else ""

                if is_selected:
                    lines.append(f"  {indicator} {active_mark}[bold white]{m['name']}[/bold white]  [dim #ff6b81]({m['group']})[/dim #ff6b81]")
                    lines.append(f"      [#ff3344]{m['id']}[/#ff3344]")
                else:
                    lines.append(f"  {indicator} {active_mark}[dim #888888]{m['name']}[/dim #888888]  [dim #555555]({m['group']})[/dim #555555]")
                    lines.append(f"      [dim #666666]{m['id']}[/dim #666666]")
                lines.append("")

        panel_content = Text.from_markup("\n".join(lines).rstrip())

        console.clear()
        console.print(Panel(
            panel_content,
            title="[bold #ff3344]◈ SELECT MODEL[/bold #ff3344]",
            title_align="left",
            border_style="#cc0029",
            box=box.ROUNDED,
            padding=(1, 2)
        ))
        console.print("  [dim #777777]↑↓ Navigate   Enter Select   / Search   Esc Back[/dim #777777]")

        # Handle Keypress
        try:
            key = read_single_key()
        except KeyboardInterrupt:
            return active_id

        if key == 'UP':
            if selected_idx > 0:
                selected_idx -= 1
        elif key == 'DOWN':
            if selected_idx < len(filtered) - 1:
                selected_idx += 1
        elif key == 'ENTER':
            if filtered:
                chosen = filtered[selected_idx]["id"]
                return chosen
            return active_id
        elif key == 'ESC':
            return active_id
        elif key == 'BACKSPACE':
            if query:
                query = query[:-1]
                selected_idx = 0
        elif key == '/':
            # Keep query or prompt search
            pass
        elif len(key) == 1 and key.isprintable():
            query += key
            selected_idx = 0


