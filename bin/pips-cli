except FileNotFoundError:
    pass
readline.set_history_length(500)


def save_history():
    try:
        readline.write_history_file(HISTORY_FILE)
    except Exception:
        pass


# ──────────────────────────────────────────────
# Header
# ──────────────────────────────────────────────
PIPS_ASCII = """\
 ██████╗ ██╗██████╗ ███████╗
 ██╔══██╗██║██╔══██╗██╔════╝
 ██████╔╝██║██████╔╝███████╗
